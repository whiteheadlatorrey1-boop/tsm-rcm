const fs = require('fs');

const p = 'test-results/playwright-results.json';
const data = JSON.parse(fs.readFileSync(p, 'utf8'));

function walk(suite, parents = []) {
  for (const spec of suite.specs || []) {
    for (const t of spec.tests || []) {
      if (t.status === 'failed' || t.status === 'unexpected') {
        console.log('\n--- FAILURE ---');
        console.log([...parents, spec.title].join(' > '));
        console.log('status:', t.status);

        for (const r of t.results || []) {
          if (r.error) {
            console.log(
              String(r.error.message || r.error)
                .replace(/\n+/g, '\n')
                .slice(0, 2500)
            );
          }
        }
      }
    }
  }

  for (const child of suite.suites || []) {
    walk(child, [...parents, suite.title].filter(Boolean));
  }
}

for (const suite of data.suites || []) {
  walk(suite);
}
NODE
