+*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
+:root{
+--bg:#03050b;--bg2:#070a12;--bg3:#0b1019;--bg4:#0f1522;
+--border:rgba(255,255,255,0.06);--border2:rgba(255,255,255,0.11);
+--text:#cdd5e0;--muted:#5e6e85;--faint:#2e3a4a;
+--cyan:#00e5ff;--cyan2:rgba(0,229,255,0.08);--cyan3:rgba(0,229,255,0.18);
+--green:#00e676;--green2:rgba(0,230,118,0.08);
+--amber:#ffb300;--amber2:rgba(255,179,0,0.10);
+--red:#ff3d57;--red2:rgba(255,61,87,0.10);
+--purple:#b060ff;--purple2:rgba(176,96,255,0.10);
+--gold:#ffd700;--gold2:rgba(255,215,0,0.08);
+--teal:#00ffd5;--teal2:rgba(0,255,213,0.08);
+--mono:'Courier New',monospace;
+}
+html,body{height:100%;background:var(--bg);color:var(--text);font-family:var(--mono);font-size:13px;overflow-x:hidden}
+body::before{content:'';position:fixed;inset:0;background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,0,0,0.03) 2px,rgba(0,0,0,0.03) 4px);pointer-events:none;z-index:1000}
+body::after{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(0,229,255,0.015) 1px,transparent 1px),linear-gradient(90deg,rgba(0,229,255,0.015) 1px,transparent 1px);background-size:48px 48px;pointer-events:none;z-index:0}
+
+/* HEADER */
+.hdr{position:relative;z-index:10;display:flex;align-items:center;justify-content:space-between;padding:12px 28px;border-bottom:1px solid var(--border2);background:linear-gradient(180deg,rgba(0,229,255,0.05) 0%,transparent 100%)}
+.hdr-left{display:flex;align-items:center;gap:14px}
+.hdr-logo{display:flex;align-items:center;gap:8px}
+.logo-hex{width:28px;height:28px;border:1px solid var(--red);display:flex;align-items:center;justify-content:center;transform:rotate(45deg)}
+.logo-hex-inner{width:10px;height:10px;background:var(--red);transform:rotate(-45deg)}
+.hdr-text .t1{font-size:14px;font-weight:700;letter-spacing:3px;color:var(--red)}
+.hdr-text .t2{font-size:8px;letter-spacing:2px;color:var(--muted);text-transform:uppercase;margin-top:2px}
+.hdr-mode{display:flex;gap:8px;margin-left:20px}
+.mode-btn{font-size:8px;letter-spacing:1.5px;text-transform:uppercase;padding:4px 14px;border:1px solid var(--border2);background:transparent;color:var(--muted);cursor:pointer;font-family:var(--mono);transition:all 0.15s}
+.mode-btn.active{color:var(--red);border-color:var(--red);background:var(--red2)}
+.hdr-right{display:flex;align-items:center;gap:10px}
+.pill{font-size:8px;letter-spacing:1.5px;text-transform:uppercase;padding:4px 12px;border:1px solid}
+.pill-red{color:var(--red);border-color:var(--red);background:var(--red2)}
+.pill-green{color:var(--green);border-color:var(--green);background:var(--green2)}
+.pill-amber{color:var(--amber);border-color:var(--amber);background:var(--amber2)}
+.pill-teal{color:var(--teal);border-color:var(--teal);background:var(--teal2)}
+.clock{font-size:9px;color:var(--muted);letter-spacing:1px}
+
+/* MAIN */
+.main{position:relative;z-index:10;padding:20px 28px 100px;max-width:1640px;margin:0 auto}
+
+/* SCENARIO BANNER */
+.scenario-banner{border:1px solid var(--red);background:linear-gradient(135deg,rgba(255,61,87,0.06) 0%,var(--bg2) 100%);padding:16px 20px;margin-bottom:20px;display:flex;align-items:center;justify-content:space-between;gap:16px}
+.sb-left{display:flex;align-items:center;gap:14px}
+.sb-icon{font-size:22px}
+.sb-label{font-size:8px;letter-spacing:2px;text-transform:uppercase;color:var(--red);margin-bottom:3px}
+.sb-title{font-size:14px;font-weight:700;letter-spacing:2px;color:var(--text)}
+.sb-sub{font-size:9px;color:var(--muted);margin-top:2px}
+.sb-right{display:flex;align-items:center;gap:10px;flex-shrink:0}
+
+/* SECTION HEADER */
+.sec{display:flex;align-items:center;gap:10px;margin-bottom:14px;margin-top:20px}
+.sec::before{content:'';width:6px;height:6px;background:var(--red);transform:rotate(45deg);flex-shrink:0}
+.sec span{font-size:8px;letter-spacing:2.5px;text-transform:uppercase;color:var(--red)}
+.sec::after{content:'';flex:1;height:1px;background:var(--border)}
+.sec.teal-sec::before{background:var(--teal)}
+.sec.teal-sec span{color:var(--teal)}
+
+/* INPUT ZONE */
+.input-zone{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px}
+.drop-panel{border:1px solid var(--border2);background:var(--bg2);padding:20px;display:flex;flex-direction:column;gap:10px}
+.drop-area{border:1px dashed var(--border2);padding:24px;text-align:center;cursor:pointer;transition:all 0.2s;position:relative;background:var(--bg)}
+.drop-area:hover{border-color:var(--red);background:var(--red2)}
+.drop-area input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%}
+.drop-icon{font-size:22px;color:var(--faint);margin-bottom:8px}
+.drop-title{font-size:10px;color:var(--muted);letter-spacing:1px}
+.drop-sub{font-size:8px;color:var(--faint);margin-top:3px;line-height:1.6}
+.format-tags{display:flex;flex-wrap:wrap;gap:4px;justify-content:center;margin-top:8px}
+.fmt-tag{font-size:7px;letter-spacing:1px;padding:2px 6px;border:1px solid var(--faint);color:var(--faint)}
+.fmt-tag.primary{border-color:var(--cyan);color:var(--cyan)}
+.doc-preview{font-size:9px;color:var(--green);margin-top:6px;min-height:14px}
+.paste-panel{border:1px solid var(--border2);background:var(--bg2);padding:20px;display:flex;flex-direction:column;gap:8px}
+.paste-label{font-size:8px;letter-spacing:2px;text-transform:uppercase;color:var(--faint)}
+textarea{flex:1;min-height:130px;background:var(--bg);border:1px solid var(--border2);color:var(--text);font-family:var(--mono);font-size:10px;padding:10px;resize:vertical;outline:none;line-height:1.6}
+textarea:focus{border-color:var(--red)}
+textarea::placeholder{color:var(--faint)}
+
+/* INGEST PROGRESS BAR */
+.ingest-bar{display:none;height:2px;background:var(--bg3);margin-top:6px;overflow:hidden}
+.ingest-bar.active{display:block}
+.ingest-fill{height:100%;background:linear-gradient(90deg,var(--cyan),var(--teal));width:0%;transition:width 0.3s;animation:ingest-pulse 1.2s ease-in-out infinite}
+@keyframes ingest-pulse{0%,100%{opacity:0.6}50%{opacity:1}}
+
+/* SAMPLE BUTTONS */
+.sample-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
+.btn{padding:8px 18px;font-size:8px;letter-spacing:2px;text-transform:uppercase;border:1px solid;cursor:pointer;font-family:var(--mono);transition:all 0.15s;background:transparent;white-space:nowrap}
+.btn-fire{color:#fff;border-color:var(--red);background:var(--red);font-size:10px;padding:10px 28px;letter-spacing:2px}
+.btn-fire:hover{background:#d42040}
+.btn-fire:disabled{opacity:0.35;cursor:not-allowed}
+.btn-sample{color:var(--amber);border-color:var(--amber);background:var(--amber2);font-size:8px;padding:6px 12px}
+.btn-sample:hover{background:rgba(255,179,0,0.2)}
+.btn-ghost{color:var(--muted);border-color:var(--border2);font-size:8px;padding:6px 12px}
+.btn-ghost:hover{color:var(--text);background:var(--bg3)}
+.process-info{font-size:9px;color:var(--faint);letter-spacing:1px;margin-left:auto}
+
+/* KEY ROW */
+.key-row{display:flex;align-items:center;gap:8px;margin-top:10px;padding:10px 12px;border:1px solid var(--border);background:var(--bg)}
+.key-dot{width:6px;height:6px;border-radius:50%;background:var(--faint);flex-shrink:0;transition:all 0.3s}
+.key-dot.ok{background:var(--green);box-shadow:0 0 6px var(--green)}
+.key-label{font-size:8px;letter-spacing:1.5px;text-transform:uppercase;color:var(--faint);white-space:nowrap}
+.key-input{flex:1;background:transparent;border:none;color:var(--text);font-family:var(--mono);font-size:10px;padding:2px 6px;outline:none}
+.key-status{font-size:8px;color:var(--faint);letter-spacing:1px}
+
+/* PIPELINE FLOW */
+.pipeline{display:flex;align-items:center;justify-content:center;gap:0;margin-bottom:20px;padding:14px 0;border:1px solid var(--border);background:var(--bg2);overflow-x:auto}
+.pipe-node{display:flex;flex-direction:column;align-items:center;gap:6px;padding:0 10px;flex-shrink:0}
+.pipe-box{width:130px;padding:10px 12px;border:1px solid;text-align:center}
+.pipe-num{font-size:7px;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:3px;opacity:0.7}
+.pipe-name{font-size:9px;font-weight:700;letter-spacing:1px;text-transform:uppercase}
+.pipe-tag{font-size:7px;letter-spacing:0.5px;margin-top:2px;opacity:0.65}
+.pipe-status{font-size:7px;letter-spacing:1px;margin-top:4px;text-transform:uppercase}
+.pipe-arrow{display:flex;flex-direction:column;align-items:center;gap:3px;flex-shrink:0}
+.pipe-line{width:28px;height:1px;background:var(--border2);position:relative}
+.pipe-line::after{content:'▶';position:absolute;right:-7px;top:-6px;font-size:9px;color:var(--faint)}
+.pipe-arrow-label{font-size:6px;letter-spacing:1px;text-transform:uppercase;color:var(--faint);white-space:nowrap}
+.e1 .pipe-box{border-color:var(--cyan);color:var(--cyan);background:var(--cyan2)}
+.e2 .pipe-box{border-color:var(--amber);color:var(--amber);background:var(--amber2)}
+.e3 .pipe-box{border-color:var(--green);color:var(--green);background:var(--green2)}
+.e4 .pipe-box{border-color:var(--purple);color:var(--purple);background:var(--purple2)}
+.e5 .pipe-box{border-color:var(--teal);color:var(--teal);background:var(--teal2)}
+.pipe-line.live{background:var(--red);animation:pulse-line 0.7s linear infinite}
+.pipe-line.live::after{color:var(--red)}
+@keyframes pulse-line{0%,100%{opacity:0.4}50%{opacity:1}}
+
+/* RESULTS GRID */
+.results-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px}
+.eng-panel{border:1px solid var(--border);background:var(--bg2);display:flex;flex-direction:column;min-height:340px}
+.eng-hdr{display:flex;align-items:center;justify-content:space-between;padding:9px 14px;border-bottom:1px solid var(--border)}
+.eng-title{display:flex;align-items:center;gap:8px}
+.eng-num{font-size:8px;letter-spacing:1px;padding:2px 7px;border:1px solid;flex-shrink:0}
+.eng-name{font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase}
+.eng-badge{font-size:7px;letter-spacing:1px;text-transform:uppercase;padding:2px 8px;border:1px solid}
+.eng-body{flex:1;padding:12px 14px;overflow-y:auto;max-height:340px}
+.eng-out{font-size:10px;line-height:1.75;color:var(--muted);white-space:pre-wrap;word-break:break-word}
+.eng-out .sh{display:block;font-size:7px;letter-spacing:2px;text-transform:uppercase;margin:10px 0 3px;font-weight:700}
+.idle-state{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:8px;color:var(--faint)}
+.idle-icon{font-size:22px;opacity:0.35}
+.idle-txt{font-size:8px;letter-spacing:1.5px;text-transform:uppercase}
+.loading-row{display:flex;align-items:center;gap:8px;font-size:9px}
+.spin{width:11px;height:11px;border:1px solid var(--faint);border-top-color:currentColor;border-radius:50%;animation:spin 0.6s linear infinite;flex-shrink:0}
+@keyframes spin{to{transform:rotate(360deg)}}
+.eng-footer{display:flex;align-items:center;gap:6px;padding:7px 14px;border-top:1px solid var(--border);background:var(--bg)}
+.foot-btn{padding:3px 10px;font-size:7px;letter-spacing:1.5px;text-transform:uppercase;border:1px solid var(--border2);background:transparent;color:var(--muted);cursor:pointer;font-family:var(--mono);transition:all 0.12s}
+.foot-btn:hover{color:var(--text);background:var(--bg3)}
+.tok-count{margin-left:auto;font-size:7px;color:var(--faint);letter-spacing:1px}
+
+/* ENGINE COLOR THEMING */
+.e1 .eng-num{color:var(--cyan);border-color:var(--cyan)}
+.e1 .eng-name{color:var(--cyan)}
+.e1 .eng-badge{color:var(--cyan);border-color:var(--cyan);background:var(--cyan2)}
+.e1 .eng-out .sh{color:var(--cyan)}
+.e1 .spin{border-top-color:var(--cyan)}
+.e1 .loading-row{color:var(--cyan)}
+.e2 .eng-num{color:var(--amber);border-color:var(--amber)}
+.e2 .eng-name{color:var(--amber)}
+.e2 .eng-badge{color:var(--amber);border-color:var(--amber);background:var(--amber2)}
+.e2 .eng-out .sh{color:var(--amber)}
+.e2 .spin{border-top-color:var(--amber)}
+.e2 .loading-row{color:var(--amber)}
+.e3 .eng-num{color:var(--green);border-color:var(--green)}
+.e3 .eng-name{color:var(--green)}
+.e3 .eng-badge{color:var(--green);border-color:var(--green);background:var(--green2)}
+.e3 .eng-out .sh{color:var(--green)}
+.e3 .spin{border-top-color:var(--green)}
+.e3 .loading-row{color:var(--green)}
+.e4 .eng-num{color:var(--purple);border-color:var(--purple)}
+.e4 .eng-name{color:var(--purple)}
+.e4 .eng-badge{color:var(--purple);border-color:var(--purple);background:var(--purple2)}
+.e4 .eng-out .sh{color:var(--purple)}
+.e4 .spin{border-top-color:var(--purple)}
+.e4 .loading-row{color:var(--purple)}
+.e5 .eng-num{color:var(--teal);border-color:var(--teal)}
+.e5 .eng-name{color:var(--teal)}
+.e5 .eng-badge{color:var(--teal);border-color:var(--teal);background:var(--teal2)}
+.e5 .eng-out .sh{color:var(--teal)}
+.e5 .spin{border-top-color:var(--teal)}
+.e5 .loading-row{color:var(--teal)}
+
+.e5-full{grid-column:1 / -1;min-height:auto}
+.nav-panel{display:none;padding:0}
+.nav-panel.visible{display:block}
+
+/* PHASE TRACKER */
+.phase-tracker{display:flex;align-items:stretch;border-bottom:1px solid var(--border);overflow-x:auto}
+.phase-tab{flex:1;min-width:120px;padding:10px 14px;border-right:1px solid var(--border);cursor:pointer;transition:all 0.15s;position:relative}
+.phase-tab:last-child{border-right:none}
+.phase-tab:hover{background:var(--bg3)}
+.phase-tab.active{background:rgba(0,255,213,0.05);border-bottom:2px solid var(--teal)}
+.phase-num{font-size:7px;letter-spacing:1.5px;text-transform:uppercase;color:var(--faint);margin-bottom:3px}
+.phase-name{font-size:9px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--muted)}
+.phase-tab.active .phase-name{color:var(--teal)}
+.phase-tab.done .phase-name{color:var(--green)}
+.phase-tab.done::after{content:'✓';position:absolute;top:8px;right:10px;font-size:10px;color:var(--green)}
+.phase-window{font-size:7px;color:var(--faint);letter-spacing:1px;margin-top:3px}
+.phase-tab.active .phase-window{color:var(--amber)}
+.phase-urgency{display:inline-block;font-size:6px;letter-spacing:1px;text-transform:uppercase;padding:1px 5px;border:1px solid;margin-top:4px}
+.ph-critical{color:var(--red);border-color:var(--red)}
+.ph-high{color:var(--amber);border-color:var(--amber)}
+.ph-medium{color:var(--cyan);border-color:var(--cyan)}
+.ph-low{color:var(--green);border-color:var(--green)}
+
+.phase-content{padding:20px}
+.step-list{display:flex;flex-direction:column;gap:0}
+.step-item{display:flex;gap:0;position:relative}
+.step-item:not(:last-child) .step-line{position:absolute;left:19px;top:38px;bottom:-1px;width:1px;background:var(--border);z-index:0}
+.step-item.done .step-line{background:var(--green)}
+.step-left{display:flex;flex-direction:column;align-items:center;flex-shrink:0;width:40px;padding-top:8px;position:relative;z-index:1}
+.step-circle{width:24px;height:24px;border:1px solid var(--border2);display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:700;letter-spacing:0;background:var(--bg2);flex-shrink:0;transition:all 0.3s}
+.step-item.done .step-circle{background:var(--green);border-color:var(--green);color:#000}
+.step-item.active .step-circle{border-color:var(--teal);color:var(--teal);box-shadow:0 0 8px rgba(0,255,213,0.3)}
+.step-item.blocked .step-circle{border-color:var(--red);color:var(--red)}
+.step-right{flex:1;padding:8px 0 20px 14px}
+.step-hdr{display:flex;align-items:center;gap:10px;margin-bottom:8px;flex-wrap:wrap}
+.step-title{font-size:11px;font-weight:700;letter-spacing:1px;color:var(--text)}
+.step-item.done .step-title{color:var(--green)}
+.step-item.active .step-title{color:var(--teal)}
+.step-tag{font-size:7px;letter-spacing:1px;text-transform:uppercase;padding:2px 8px;border:1px solid}
+.step-tag-owner{color:var(--amber);border-color:var(--amber);background:var(--amber2)}
+.step-tag-deadline{color:var(--red);border-color:var(--red);background:var(--red2)}
+.step-tag-tool{color:var(--cyan);border-color:var(--cyan);background:var(--cyan2)}
+.step-tag-done{color:var(--green);border-color:var(--green);background:var(--green2)}
+.step-body{font-size:9px;line-height:1.7;color:var(--muted);margin-bottom:10px}
+.step-actions{display:flex;flex-direction:column;gap:8px;margin-top:10px}
+.step-checklist{display:flex;flex-direction:column;gap:4px;margin-bottom:10px}
+.step-check{display:flex;align-items:flex-start;gap:8px;font-size:9px;color:var(--muted);line-height:1.5}
+.check-box{width:12px;height:12px;border:1px solid var(--border2);flex-shrink:0;margin-top:1px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all 0.15s}
+.check-box:hover{border-color:var(--teal)}
+.check-box.checked{background:var(--teal);border-color:var(--teal)}
+.check-box.checked::after{content:'✓';font-size:8px;color:#000;font-weight:700}
+
+.app-rec-section{margin-top:12px}
+.app-rec-label{font-size:7px;letter-spacing:2px;text-transform:uppercase;color:var(--teal);margin-bottom:8px;display:flex;align-items:center;gap:6px}
+.app-rec-label::before{content:'▶';font-size:6px}
+.app-cards{display:flex;flex-wrap:wrap;gap:8px}
+.app-card{border:1px solid var(--border2);background:var(--bg);padding:10px 14px;cursor:pointer;transition:all 0.2s;text-decoration:none;display:flex;align-items:center;gap:10px;min-width:200px;flex:1;max-width:320px}
+.app-card:hover{border-color:var(--teal);background:var(--teal2);transform:translateY(-1px)}
+.app-card.primary{border-color:var(--teal);background:var(--teal2)}
+.app-card-icon{font-size:16px;flex-shrink:0}
+.app-card-body{flex:1;min-width:0}
+.app-card-name{font-size:9px;font-weight:700;letter-spacing:1px;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.app-card:hover .app-card-name{color:var(--teal)}
+.app-card.primary .app-card-name{color:var(--teal)}
+.app-card-why{font-size:7px;color:var(--muted);letter-spacing:0.5px;margin-top:2px;line-height:1.4}
+.app-card-badge{font-size:6px;letter-spacing:1px;text-transform:uppercase;padding:2px 6px;border:1px solid var(--teal);color:var(--teal);margin-top:4px;display:inline-block}
+.app-card-arrow{font-size:10px;color:var(--faint);flex-shrink:0}
+.app-card:hover .app-card-arrow{color:var(--teal)}
+
+.bnca-alert{border:1px solid var(--teal);background:linear-gradient(135deg,rgba(0,255,213,0.06) 0%,var(--bg2) 100%);padding:16px 20px;margin-bottom:16px;animation:bnca-in 0.4s ease-out}
+@keyframes bnca-in{from{opacity:0;transform:translateX(-8px)}to{opacity:1;transform:translateX(0)}}
+.bnca-hdr{display:flex;align-items:center;gap:10px;margin-bottom:12px}
+.bnca-icon{font-size:18px}
+.bnca-label{font-size:7px;letter-spacing:2px;text-transform:uppercase;color:var(--teal)}
+.bnca-title{font-size:12px;font-weight:700;letter-spacing:1.5px;color:var(--text)}
+.bnca-body{font-size:10px;line-height:1.7;color:var(--muted);margin-bottom:12px}
+.bnca-priority-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:10px}
+.bnca-priority{padding:5px 12px;font-size:8px;letter-spacing:1.5px;text-transform:uppercase;border:1px solid;cursor:pointer;transition:all 0.15s;font-family:var(--mono)}
+.bnca-p1{color:var(--red);border-color:var(--red);background:var(--red2)}
+.bnca-p2{color:var(--amber);border-color:var(--amber);background:var(--amber2)}
+.bnca-p3{color:var(--cyan);border-color:var(--cyan);background:var(--cyan2)}
+.bnca-p1:hover{background:rgba(255,61,87,0.2)}
+.bnca-p2:hover{background:rgba(255,179,0,0.2)}
+.bnca-p3:hover{background:rgba(0,229,255,0.2)}
+
+.timeline-ruler{display:flex;border:1px solid var(--border);background:var(--bg);margin:16px 0;overflow:hidden}
+.tl-seg{flex:1;padding:10px 12px;border-right:1px solid var(--border);position:relative}
+.tl-seg:last-child{border-right:none}
+.tl-seg.tl-critical{background:rgba(255,61,87,0.05)}
+.tl-seg.tl-high{background:rgba(255,179,0,0.04)}
+.tl-seg.tl-medium{background:rgba(0,229,255,0.03)}
+.tl-label{font-size:7px;letter-spacing:1.5px;text-transform:uppercase;color:var(--faint);margin-bottom:5px}
+.tl-window{font-size:10px;font-weight:700;letter-spacing:1px}
+.tl-critical .tl-window{color:var(--red)}
+.tl-high .tl-window{color:var(--amber)}
+.tl-medium .tl-window{color:var(--cyan)}
+.tl-items{font-size:8px;color:var(--muted);line-height:1.7;margin-top:4px}
+
+.escalation-path{display:flex;align-items:center;gap:0;margin:12px 0;overflow-x:auto;padding:2px 0}
+.esc-node{display:flex;flex-direction:column;align-items:center;gap:4px;padding:10px 16px;border:1px solid var(--border2);background:var(--bg);flex-shrink:0}
+.esc-node.active-esc{border-color:var(--teal);background:var(--teal2)}
+.esc-node.escalated{border-color:var(--amber);background:var(--amber2)}
+.esc-role{font-size:8px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--muted)}
+.esc-node.active-esc .esc-role{color:var(--teal)}
