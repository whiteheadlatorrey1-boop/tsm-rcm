+// ── TRUST & EVIDENCE: RECORD THIS DECISION ──
+// Fires once per generated recommendation, right after it's rendered.
+// Does not affect the demo flow if the evidence-ledger script failed to
+// load or errors for any reason — this is observational, not load-bearing.
+let lastEvidenceRecordId = null;
+function recordDecisionEvidence(obj) {
+  try {
+    if (!window.TSM || !window.TSM.evidenceLedger) return;
+
+    const decisionId = warData?.extraction?.anomalyCode
+      || warData?.extraction?.anomalyEntity
+      || ('bpo_' + Date.now());
+
+    const summaryText = (obj.recommendedActions && obj.recommendedActions[0] && obj.recommendedActions[0].text)
+      || 'BPO strategy recommendation generated';
+
+    const dataRefs = (obj.dataSources || []).map(s => s.name).filter(Boolean);
+
+    const record = window.TSM.evidenceLedger.record({
+      domain: 'BPO',
+      decisionId: decisionId,
+      summary: summaryText,
+      ruleIds: [], // no policy-intelligence engine is wired into this chain yet
+      dataRefs: dataRefs,
+      confidence: typeof obj.confidence === 'number' ? obj.confidence / 100 : null,
+      actor: 'BPO_STRATEGIST_V2',
+    });
+
+    lastEvidenceRecordId = record.id;
+  } catch (e) {
+    console.warn('[Trust Evidence] record failed', e);
+  }
+}
