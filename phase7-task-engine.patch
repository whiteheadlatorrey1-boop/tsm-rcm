+  if (!allMissions.length) {
+    el.innerHTML = '<div style="color:var(--muted);font-family:\'JetBrains Mono\',monospace;font-size:.68rem">No missions in the store yet.</div>';
+    return;
+  }
+
+  // Per-vertical breakdown: mission counts + avg task completion.
+  const byVertical = {};
+  allMissions.forEach(m => {
+    if (!byVertical[m.vertical]) byVertical[m.vertical] = { total: 0, open: 0, closed: 0, completionSum: 0 };
+    const v = byVertical[m.vertical];
+    v.total++;
+    if (m.stage === 'closed') v.closed++; else v.open++;
+    v.completionSum += window.TSMMissionModel.completionPercent(m);
+  });
