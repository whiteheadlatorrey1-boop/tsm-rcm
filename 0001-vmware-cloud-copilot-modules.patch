+  // ── VMware Script Generator ────────────────────────────────────────────────
+  async function generateVmwareScript(){
+    const request = document.getElementById('vmwScriptRequest').value.trim();
+    const scriptType = document.getElementById('vmwScriptType').value;
+    if (!request) { alert('Describe what the script needs to do first.'); return; }
+    const out = document.getElementById('vmwScriptOutput');
+    out.className = 'ai-output loading';
+    out.textContent = 'Generating ' + scriptType + ' script...';
+    try {
+      const res = await fetch('/api/l1-copilot/vmware-script', {
+        method: 'POST', headers: { 'Content-Type':'application/json' },
+        body: JSON.stringify({ scriptType, request })
+      });
+      const data = await res.json();
+      if (!data.ok) throw new Error(data.error || 'Script generation failed');
+      out.className = 'ai-output';
+      out.textContent = data.answer || 'No script returned.';
+    } catch (e) {
+      out.className = 'ai-output';
+      out.innerHTML = `<span class="err">Generation failed: ${e.message}. Confirm /api/l1-copilot/vmware-script is wired server-side.</span>`;
+    }
+  }
+  document.getElementById('btnVmwScript').addEventListener('click', generateVmwareScript);
+  document.getElementById('btnVmwScriptClear').addEventListener('click', () => {
+    document.getElementById('vmwScriptRequest').value = '';
+    document.getElementById('vmwScriptOutput').className = 'ai-output';
+    document.getElementById('vmwScriptOutput').textContent = 'Generated script will appear here.';
+  });
+
+  // ── Launch full VMware Operations module, carrying ticket context via relay ─
+  document.getElementById('btnOpenVmwModule').addEventListener('click', () => {
+    try {
+      if (window.TSM && window.TSM.relay) {
+        window.TSM.relay.write('VMWARE_COPILOT', {
+          ticketId: document.getElementById('tkIncident') ? document.getElementById('tkIncident').value : '',
+          issueSummary: (currentAnalysis && currentAnalysis.issue_summary) || '',
+          component: document.getElementById('vmwComponent').value,
+          category: document.getElementById('vmwCategory').value,
+          environment: document.getElementById('vmwEnv').value
+        });
+      }
+    } catch (e) { /* relay is best-effort, don't block navigation */ }
+    window.open('/html/l1-copilot/vmware-copilot.html', '_blank');
+  });
+
+  // ── Cloud Ops ───────────────────────────────────────────────────────────────
+  async function getCloudGuidance(){
+    const input = document.getElementById('cloudInput').value.trim();
+    if (!input) { alert('Paste logs, config, or a question first.'); return; }
+    const out = document.getElementById('cloudOutput');
+    out.className = 'ai-output loading';
+    out.textContent = 'Getting Cloud Ops SME guidance...';
+    try {
+      const res = await fetch('/api/l1-copilot/cloud-ops', {
+        method: 'POST', headers: { 'Content-Type':'application/json' },
+        body: JSON.stringify({
+          provider: document.getElementById('cloudProvider').value,
+          service: document.getElementById('cloudService').value,
+          environment: document.getElementById('cloudEnv').value,
+          input,
+          issueSummary: (currentAnalysis && currentAnalysis.issue_summary) || ''
+        })
+      });
+      const data = await res.json();
+      if (!data.ok) throw new Error(data.error || 'Cloud Ops guidance failed');
+      out.className = 'ai-output';
+      out.textContent = data.answer || 'No guidance returned.';
+    } catch (e) {
+      out.className = 'ai-output';
+      out.innerHTML = `<span class="err">Lookup failed: ${e.message}. Confirm /api/l1-copilot/cloud-ops is wired server-side.</span>`;
+    }
+  }
+  document.getElementById('btnCloudGuidance').addEventListener('click', getCloudGuidance);
+  document.getElementById('btnCloudClear').addEventListener('click', () => {
+    document.getElementById('cloudInput').value = '';
+    document.getElementById('cloudOutput').className = 'ai-output';
+    document.getElementById('cloudOutput').textContent = 'Root cause, recommended fix, CLI/portal steps, and escalation guidance will appear here.';
+  });
