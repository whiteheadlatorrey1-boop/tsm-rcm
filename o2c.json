        { "id": "changeorder", "label": "Change Order Approval", "order": 3, "sla_hours": 72, "is_blocking": true,  "blocking_metric_key": "change_order_holds" },
        { "id": "progress",    "label": "Progress Billing",      "order": 4, "sla_hours": 24, "is_blocking": false },
        { "id": "retainage",   "label": "Retainage Hold",        "order": 5, "sla_hours": 0,  "is_blocking": true,  "blocking_metric_key": "retainage_holds" },
        { "id": "collections", "label": "Collections",          "order": 6, "sla_hours": 96, "is_blocking": true,  "blocking_metric_key": "collection_holds" }
