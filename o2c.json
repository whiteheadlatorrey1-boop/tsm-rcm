{
  "capability": "order_to_cash",
  "generic_record_noun": "order",
  "message_templates": {
    "blocker_claim": "{order_id} ({customer}) is ${value} stalled {hours_over}h past its \"{stage}\" SLA",
    "blocker_rationale": "{order_id} for {customer} entered the \"{stage}\" stage {hours_in_stage}h ago."
  },
