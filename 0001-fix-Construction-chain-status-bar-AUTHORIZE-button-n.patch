+function tsmConfirmExec(){
+  // Real EXEC_CONFIRMED write (Convention A shape) — read by
+  // tsm-demo-runner.js AUTO-RUN and core/tsm-enforcer.js health audit.
+  // Previously this button had no click handler at all; nothing ever
+  // set TSM_EXEC_CONFIRMED_* for any vertical through any code path.
