From 44a4b67e79527ad6b63cc620a80eedd49fc6b1ae Mon Sep 17 00:00:00 2001
From: Tron <tron@tsmconsultz.dev>
Date: Sat, 1 Aug 2026 06:43:56 +0000
Subject: [PATCH] fix: invert TSM_AUTO_LAUNCH default from opt-out to opt-in
 (repo-wide)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

tsm-auto-pipeline.js is loaded by 30 strategist/war-room/exec-portal
pages across every vertical (healthcare, finops, insurance, construction,
legal, real estate, bpo, cpq, o2c, crm, approval, mdm, integration,
governance, digital-twin, catalog). Its init() only skipped auto-launch
when TSM_AUTO_LAUNCH was explicitly 'false' — and the only place in the
app that ever sets that flag is a floating toggle button on the unrelated
tsm-doc-search-multi.html page, not on any strategist page itself. In
practice this meant every strategist page auto-ran its full AI analysis
chain the instant it detected relay data in storage, for every user, with
no prompt and no discoverable way to turn it off from the page where it
actually happened.

This was the second, independent cause of insurance-strategist.html
auto-populating after the earlier fix removed only the page's own inline
auto-run IIFE — this shared engine has its own separate detection/launch
logic and was never touched by that fix.

Flipped the default: auto-launch now requires TSM_AUTO_LAUNCH to be
explicitly 'true' (e.g. via TSMAutoPipeline.enable()). Nothing auto-runs
by default anywhere this script is loaded. Updated the toggle button on
tsm-doc-search-multi.html to match the new polarity.

Not touched: tsm-autorun-engine.js (loaded on insurance-war-room.html)
already defaults to off — it requires an explicit ?autorun=1 URL param or
tsm_auto_mode='on' to fire, so it wasn't a contributor here. Also not
touched: BPO/logistics/supplier-vendor pages that have their own separate
inline 'if TSM_AUTO_LAUNCH === false, return' guards predating this
script — those still default to on for whatever they gate, since they
read the same flag but don't share this file's logic. Flagging for a
follow-up pass if the same untrustworthy-by-default pattern matters there
too.
---
 html/js/core/tsm-auto-pipeline.js | 10 +++++++++-
 html/tsm-doc-search-multi.html    |  2 +-
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/html/js/core/tsm-auto-pipeline.js b/html/js/core/tsm-auto-pipeline.js
index 496bab02..63498ff6 100644
--- a/html/js/core/tsm-auto-pipeline.js
+++ b/html/js/core/tsm-auto-pipeline.js
@@ -161,7 +161,15 @@ window.TSMEventBus = window.TSMEventBus || {
 
   async function init() {
     if (localStorage.getItem('tsm_auto_mode') === 'off') { log('Auto-mode OFF'); return; }
-    if (localStorage.getItem('TSM_AUTO_LAUNCH') === 'false') { log('TSM_AUTO_LAUNCH=false'); return; }
+    // Auto-launch is opt-in, not opt-out. Previously this only bailed when
+    // TSM_AUTO_LAUNCH was explicitly 'false', so every strategist page on
+    // every vertical auto-ran its full analysis chain by default, the
+    // instant it detected relay data in storage — with zero prompt, and the
+    // only opt-out being a toggle button that lives on an unrelated
+    // document-search page nobody visiting a strategist page directly would
+    // ever see. Now nothing auto-launches unless something has explicitly
+    // set TSM_AUTO_LAUNCH to 'true' (e.g. via TSMAutoPipeline.enable()).
+    if (localStorage.getItem('TSM_AUTO_LAUNCH') !== 'true') { log('Auto-launch not explicitly enabled — skipping'); return; }
 
     const vertical = detectVertical();
     if (!vertical) { log('Vertical not detected'); return; }
diff --git a/html/tsm-doc-search-multi.html b/html/tsm-doc-search-multi.html
index 2a723fc8..0f2bbbc3 100644
--- a/html/tsm-doc-search-multi.html
+++ b/html/tsm-doc-search-multi.html
@@ -3890,7 +3890,7 @@ window.openGenNodeWithDoc = openGenNodeWithDoc;
 <script>
 /* TSM AUTO-LAUNCH TOGGLE */
 (function(){
-  const isOn = () => localStorage.getItem('TSM_AUTO_LAUNCH') !== 'false';
+  const isOn = () => localStorage.getItem('TSM_AUTO_LAUNCH') === 'true';
   const btn = document.createElement('button');
   btn.id = 'tsm-auto-launch-btn';
   btn.title = 'Toggle Auto-Launch Pipeline';
-- 
