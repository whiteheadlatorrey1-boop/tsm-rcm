+++ b/html/bpo/bpo-situation-room.html
@@ -173,7 +173,7 @@ body::before{content:'';position:fixed;inset:0;background:repeating-linear-gradi
 .bnca-text strong{color:var(--amber);}
 
 /* ── BOTTOM ACTION BAR ── */
-.action-bar{height:52px;background:#020810;border-top:2px solid var(--border);display:flex;align-items:center;padding:0 20px;gap:10px;position:sticky;bottom:0;}
+.action-bar{height:52px;background:#020810;border-top:2px solid var(--border);display:flex;align-items:center;padding:0 20px;gap:10px;position:sticky;bottom:32px;z-index:10;}
 .action-bar-label{font-family:'Orbitron',sans-serif;font-size:.58rem;color:var(--muted);margin-right:6px;}
 .act-btn{padding:8px 18px;border-radius:3px;font-family:'Orbitron',sans-serif;font-size:.6rem;cursor:pointer;letter-spacing:.08em;transition:.2s;border:1px solid;}
 .act-btn.primary{background:var(--red);border-color:var(--red);color:#fff;}
diff --git a/html/war-rooms/war-room-prep.html b/html/war-rooms/war-room-prep.html
