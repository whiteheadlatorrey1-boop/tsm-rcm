@@ -1241,6 +1263,17 @@
 </div>
 
 <script>
+// Keep nav's sticky offset in sync with the header's real rendered height —
+// the header can wrap to two lines on narrower viewports, which previously
+// caused the left nav panel to overlap/hide under it.
+function syncHeaderHeight(){
+  const h = document.querySelector('header');
+  if(h) document.documentElement.style.setProperty('--header-h', h.offsetHeight + 'px');
+}
+syncHeaderHeight();
+window.addEventListener('resize', syncHeaderHeight);
+window.addEventListener('load', syncHeaderHeight);
+
 const WR_IDS = ['hc','finops','ins','con','legal','re','bpo','phase3'];
 const WR_NAMES = {hc:'Healthcare',finops:'FinOps',ins:'Insurance',con:'Construction',legal:'Legal',re:'Real Estate',bpo:'BPO',phase3:'Phase 3'};
