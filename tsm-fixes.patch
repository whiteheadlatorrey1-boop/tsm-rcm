   nav { width: 240px; box-sizing: border-box; overflow-x: hidden;
     border-right: 1px solid var(--border);
     padding: 1.5rem 0;
     position: sticky;
-    top: 61px;
-    height: calc(100vh - 61px);
+    top: var(--header-h, 61px);
+    height: calc(100vh - var(--header-h, 61px));
     overflow-y: auto;
-    
+    background: var(--bg);
+    z-index: 10;
   }
   .nav-label { font-size: 9px; letter-spacing: .12em; color: var(--text3); padding: 0 1.25rem .5rem; }
   .nav-section { border-top: 1px solid var(--border); margin-top: 1rem; padding-top: .75rem; }
