 <script>
 function tick(){document.getElementById('clock').textContent=new Date().toLocaleTimeString();}
 setInterval(tick,1000);tick();
@@ -197,6 +207,44 @@ function impactFromSeverity(sev){
   return { cls: 'low', label: 'LOW IMPACT' };
 }
 
+// Business Impact Delta — deterministic, no LLM-guessed dollars. Reuses the
+// exact total_exposure figure the mortgage engine already computes from the
+// financial_model rate card (closing-delay + compliance exposure) and hands
+// it to the same shared TSMBNCAExposureEngine used by Insurance/RE/
+// Healthcare/BPO/FinOps/Legal/HotelOps -- nothing invented here.
+function severityFromSlaRatio(overSla, openLoans){
+  if (!openLoans) return overSla > 0 ? 'MED' : 'LOW';
+  const ratio = overSla / openLoans;
+  if (ratio >= 0.30) return 'CRIT';
+  if (ratio >= 0.15) return 'HIGH';
+  if (ratio > 0) return 'MED';
+  return 'LOW';
+}
+
+function renderBusinessImpactDelta(data){
+  const fin = data.financials || {};
+  const baseExposure = Number(fin.total_exposure) || 0;
+  if (!baseExposure || !window.TSMBNCAExposureEngine) {
+    return `<div class="sec"><div class="sec-hdr"><span class="lbl">BUSINESS IMPACT DELTA</span></div><div class="no-items">No quantifiable exposure reported${fin.note ? ' — ' + escapeHtml(fin.note) : ''}.</div></div>`;
+  }
+  const kpis = data.kpis || {};
+  const severity = severityFromSlaRatio(kpis.loans_over_sla || 0, kpis.open_loan_files || 0);
+  const impact = window.TSMBNCAExposureEngine.project({
+    baseExposure, severity,
+    confidence: 70, // no distinct AI-confidence signal for this vertical (rule-based engine, not an LLM call) -- engine's own documented neutral default
+    daysUntilDeadline: 0 // no per-loan deadline day-count surfaced to the strategist relay yet
+  });
+  const fmt = n => '$' + Math.round(n).toLocaleString('en-US');
+  return `<div class="sec">
+    <div class="sec-hdr"><span class="lbl">BUSINESS IMPACT DELTA</span><span class="sec-hdr-note">closing-delay + compliance exposure &middot; deterministic projection</span></div>
+    <div class="tsm-delta-row">
+      <div class="tsm-delta-box tsm-delta-no"><div class="tsm-delta-lbl">No Action</div><div class="tsm-delta-val">${fmt(impact.ifIgnored.exposure)}</div></div>
+      <div class="tsm-delta-box tsm-delta-act"><div class="tsm-delta-lbl">With Action</div><div class="tsm-delta-val">${fmt(impact.ifActed.exposure)}</div></div>
+    </div>
+    <div class="tsm-recovery">${escapeHtml(impact.urgencyWindow)} &middot; ${escapeHtml(impact.methodology)}</div>
+  </div>`;
+}
+
 function renderWipBoard(wip){
   if(!wip || !wip.length) return '';
   const stages = wip.map(s => {
@@ -279,6 +327,7 @@ function render(){
   }
 
   html += renderWipBoard(data.loan_wip);
+  html += renderBusinessImpactDelta(data);
   html += renderActionQueue(data.records, breachIds);
 
   document.getElementById('wrap').innerHTML = html;
