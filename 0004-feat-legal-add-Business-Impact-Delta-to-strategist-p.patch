From a633a06b4c7f35d004385f0917b9638c62dc4db2 Mon Sep 17 00:00:00 2001
From: Tron <tron@tsmconsultz.com>
Date: Wed, 5 Aug 2026 02:53:42 +0000
Subject: [PATCH 4/6] feat(legal): add Business Impact Delta to strategist page
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Adds a No-Action / With-Action exposure projection box using the shared
TSMBNCAExposureEngine (same deterministic engine as Insurance/RE/
Healthcare/BPO/FinOps/HotelOps). Fires from populateFromRelay() as soon
as War Room engine data loads, reusing the same kpi-exposure/kpi-risk
values already rendered on the KPI tiles -- no separately-invented
numbers. Severity banding and the confidence-from-risk-score inversion
mirror the existing legalProSeverityForRisk/confidence logic already
used by this page's Sentinel push, just promoted so the delta box can
use it too.

Honesty pattern: shows '—' with 'No quantifiable exposure parsed from
this relay' when the exposure KPI can't be parsed to a number, rather
than a fabricated delta.
---
 .../legal-war/legal-main-strategist.html      | 57 +++++++++++++++++++
 1 file changed, 57 insertions(+)

diff --git a/html/war-rooms/legal-war/legal-main-strategist.html b/html/war-rooms/legal-war/legal-main-strategist.html
index 3a04cc23..1002a182 100644
--- a/html/war-rooms/legal-war/legal-main-strategist.html
+++ b/html/war-rooms/legal-war/legal-main-strategist.html
@@ -134,6 +134,15 @@ body::after{content:'';position:fixed;inset:0;pointer-events:none;z-index:1000;
 .kpi-val{font-family:var(--sans);font-size:26px;font-weight:800;line-height:1;}
 .kpi-sub{font-size:7px;color:var(--faint);margin-top:3px;}
 
+/* Business Impact Delta */
+.tsm-delta-row{display:flex;gap:1px;background:var(--border2);border:1px solid var(--border2);margin-bottom:4px;}
+.tsm-delta-box{flex:1;background:var(--bg2);padding:14px 16px;text-align:center;}
+.tsm-delta-lbl{font-size:6.5px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:4px;}
+.tsm-delta-val{font-family:var(--sans);font-size:20px;font-weight:800;line-height:1;}
+.tsm-delta-no .tsm-delta-val{color:var(--red);}
+.tsm-delta-act .tsm-delta-val{color:var(--green);}
+.tsm-recovery{font-size:7px;color:var(--faint);text-align:center;margin-bottom:16px;}
+
 /* Synthesis output */
 .synthesis-panel{background:var(--bg2);border:1px solid var(--border2);}
 .sp-hdr{display:flex;align-items:center;justify-content:space-between;
@@ -218,6 +227,7 @@ body::after{content:'';position:fixed;inset:0;pointer-events:none;z-index:1000;
   <script src="/html/war-rooms/_relay_control_plane/relay.core.js"></script>
   <script src="/html/shared/runtime/mission/mission-model.js"></script>
   <script src="/html/shared/runtime/mission/mission-store.js"></script>
+  <script src="/html/js/tsm-bnca-exposure-engine.js"></script>
   <script src="/js/core/tsm-mission-engine.js"></script>
   <script src="/js/core/tsm-auto-pipeline.js"></script>
 </head>
@@ -354,6 +364,14 @@ body::after{content:'';position:fixed;inset:0;pointer-events:none;z-index:1000;
       </div>
     </div>
 
+    <!-- BUSINESS IMPACT DELTA -->
+    <div class="sec"><div class="sec-label">Business Impact Delta</div></div>
+    <div class="tsm-delta-row">
+      <div class="tsm-delta-box tsm-delta-no"><div class="tsm-delta-lbl">No Action</div><div class="tsm-delta-val" id="legXPDeltaNo">—</div></div>
+      <div class="tsm-delta-box tsm-delta-act"><div class="tsm-delta-lbl">With Action</div><div class="tsm-delta-val" id="legXPDeltaAct">—</div></div>
+    </div>
+    <div class="tsm-recovery" id="legXPRecovery">Awaiting War Room relay.</div>
+
     <!-- ENGINE OUTPUTS (from relay) -->
     <div class="sec"><div class="sec-label">War Room Engine Outputs · Relay Data</div></div>
     <div class="engine-grid">
@@ -622,6 +640,45 @@ function populateFromRelay(d) {
   document.getElementById('rm-settle').textContent = extractSettle(e3) || '—';
   document.getElementById('rm-deadline').textContent = extractDeadline(e3) || 'Verify';
 
+  // Business Impact Delta — deterministic, no LLM-guessed dollars. Uses the
+  // same shared TSMBNCAExposureEngine as Insurance/RE/Healthcare/BPO/FinOps/
+  // HotelOps; only the inputs differ. Reuses the same exposure/risk fields
+  // just written to the KPI tiles above — no separately-invented numbers.
+  try {
+    if (window.TSMBNCAExposureEngine) {
+      const legXPExposureStr = document.getElementById('kpi-exposure').textContent;
+      const legXPRiskStr = document.getElementById('kpi-risk').textContent;
+      const legXPParseExposure = str => {
+        if (!str) return 0;
+        const nums = String(str).match(/[\d,]+(?:\.\d+)?/g);
+        if (!nums || !nums.length) return 0;
+        const mult = /m\b/i.test(str) ? 1000000 : (/k\b/i.test(str) ? 1000 : 1);
+        const vals = nums.map(n => parseFloat(n.replace(/,/g,'')) * mult);
+        return Math.round(vals.reduce((a,b)=>a+b,0) / vals.length);
+      };
+      const legXPRiskNum = parseInt(legXPRiskStr, 10) || 0;
+      const legXPSeverity = legXPRiskNum >= 75 ? 'CRIT' : legXPRiskNum >= 55 ? 'HIGH' : legXPRiskNum >= 30 ? 'MED' : 'LOW';
+      const legXPBaseExposure = legXPParseExposure(legXPExposureStr);
+      if (legXPBaseExposure > 0) {
+        const legXPImpact = window.TSMBNCAExposureEngine.project({
+          baseExposure: legXPBaseExposure,
+          severity: legXPSeverity,
+          confidence: Math.max(0, 100 - legXPRiskNum),
+          daysUntilDeadline: 0 // no parseable deadline day-count for this vertical yet (extractDeadline returns free text)
+        });
+        const legXPFmt = n => '$' + Math.round(n).toLocaleString('en-US');
+        document.getElementById('legXPDeltaNo').textContent = legXPFmt(legXPImpact.ifIgnored.exposure);
+        document.getElementById('legXPDeltaAct').textContent = legXPFmt(legXPImpact.ifActed.exposure);
+        document.getElementById('legXPRecovery').textContent = legXPImpact.urgencyWindow + ' · ' + legXPImpact.methodology;
+      } else {
+        document.getElementById('legXPDeltaNo').textContent = '—';
+        document.getElementById('legXPDeltaAct').textContent = '—';
+        document.getElementById('legXPRecovery').textContent = 'No quantifiable exposure parsed from this relay.';
+      }
+    }
+  } catch (legDeltaErr) { console.warn('[bnca-exposure-engine] legal render error:', legDeltaErr); }
+
+
   // Enable synthesis
   document.getElementById('synth-btn').disabled = synced < 1;
 
