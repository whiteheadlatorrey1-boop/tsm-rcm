+// ── INTERVIEW PROOF MAP SIMULATOR ──
+let iqQuestionId = null, iqQuestionText = null;
+let iqLensLabel = null, iqLensDesc = null;
+
+function iqSelect(btn, id, questionText) {
+  iqQuestionId = id;
+  iqQuestionText = questionText;
+  document.querySelectorAll('.iq-qbtn').forEach(b => b.classList.remove('sel'));
+  btn.classList.add('sel');
+  const el = document.getElementById('iq-selected-q');
+  el.textContent = 'Q: ' + questionText;
+  el.style.display = 'block';
+}
+
+function iqLens(btn, label, desc) {
+  iqLensLabel = label;
+  iqLensDesc = desc;
+  document.querySelectorAll('.iq-lbtn').forEach(b => b.classList.remove('sel'));
+  btn.classList.add('sel');
+  const el = document.getElementById('iq-selected-lens');
+  el.textContent = 'Lens: ' + label;
+  el.style.display = 'block';
+}
+
+async function iqGenerate() {
+  if (!iqQuestionText || !iqLensLabel) {
+    alert('Select a question and a proof lens first.');
+    return;
+  }
+  const loading = document.getElementById('iq-loading');
+  const output = document.getElementById('iq-output');
+  const meta = document.getElementById('iq-meta');
+  loading.style.display = 'block';
+  output.style.display = 'none';
+  meta.style.display = 'none';
+  output.textContent = '';
+
+  const prompt = `Interview question: "${iqQuestionText}"\n\n` +
+    `Answer it using this specific TSM Shell workflow as the concrete proof point: ${iqLensLabel} — ${iqLensDesc}\n\n` +
+    `Write an 80-120 word presales-strength interview answer. Reference specific architecture details from the lens above. No preamble.`;
+
+  try {
+    const res = await fetch('/api/career/ai-complete', {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ maxTokens: 500, messages: [{ role: 'user', content: prompt }] })
+    });
+    const data = await res.json();
+    const text = data.content?.map(c => c.text || '').join('') || 'No response.';
+    output.textContent = text;
+    meta.innerHTML = `<span>Question: ${iqQuestionText}</span><span>Lens: ${iqLensLabel}</span>`;
+    meta.style.display = 'flex';
+  } catch (e) {
+    output.textContent = 'Error connecting to AI.';
+  }
+  loading.style.display = 'none';
+  output.style.display = 'block';
+}
+
+function iqCopy() {
+  const output = document.getElementById('iq-output');
+  const btn = document.getElementById('iq-copy-btn');
+  if (!output.textContent) return;
+  navigator.clipboard?.writeText(output.textContent).catch(() => {});
+  const original = btn.textContent;
+  btn.textContent = '✓ COPIED';
+  setTimeout(() => { btn.textContent = original; }, 1500);
+}
+
+function iqClear() {
+  iqQuestionId = null; iqQuestionText = null;
+  iqLensLabel = null; iqLensDesc = null;
+  document.querySelectorAll('.iq-qbtn, .iq-lbtn').forEach(b => b.classList.remove('sel'));
+  document.getElementById('iq-selected-q').style.display = 'none';
+  document.getElementById('iq-selected-lens').style.display = 'none';
+  document.getElementById('iq-output').style.display = 'none';
+  document.getElementById('iq-output').textContent = '';
+  document.getElementById('iq-meta').style.display = 'none';
+  document.getElementById('iq-loading').style.display = 'none';
+}
