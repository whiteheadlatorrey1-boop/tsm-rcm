+    <button class="hbtn" id="printBtn" onclick="window.print()">&darr; Export</button>
+  </div>
+</div>
+<div class="wrap" id="wrap"><!-- populated by JS --></div>
+<div class="toast" id="toast"></div>
+<script>
+function tick(){document.getElementById('clock').textContent=new Date().toLocaleTimeString();}
+setInterval(tick,1000);tick();
+
+const CFG = {"domain": "APPROVAL", "kpiPath": "kpis", "kpis": [{"key": "total_requests", "label": "TOTAL REQUESTS", "fmt": "num", "cls": "cyan"}, {"key": "pending_requests", "label": "PENDING", "fmt": "num", "cls": "amber"}, {"key": "escalated_count", "label": "ESCALATED", "fmt": "num", "cls": "red"}, {"key": "sla_breach_count", "label": "SLA BREACHES", "fmt": "num", "cls": "red"}, {"key": "approval_rate_pct", "label": "APPROVAL RATE", "fmt": "pct", "cls": "green"}, {"key": "avg_cycle_hours", "label": "AVG CYCLE (HRS)", "fmt": "num", "cls": "cyan"}], "lists": [{"path": "attention_flags", "label": "ATTENTION FLAGS"}], "aiPaths": ["ai_analysis"], "title": "Approval Chain", "isExec": true};
+const RELAY_KEY_FALLBACK = 'TSM_' + CFG.domain + '_RELAY';
+
+function showToast(msg){
+  const t=document.getElementById('toast');
+  t.textContent=msg; t.classList.add('show');
+  clearTimeout(showToast._h);
+  showToast._h=setTimeout(()=>t.classList.remove('show'),2500);
+}
+
+function loadRelay(){
+  try {
+    if(window.TSM && window.TSM.relay && window.TSM.relay.read){
+      const d = window.TSM.relay.read(CFG.domain);
+      if(d) return d;
+    }
+  } catch(e){}
+  try {
+    const raw = sessionStorage.getItem(RELAY_KEY_FALLBACK) || localStorage.getItem(RELAY_KEY_FALLBACK);
+    return raw ? JSON.parse(raw) : null;
+  } catch(e){ return null; }
+}
+
+function getPath(obj, path){
+  if(!path) return obj;
+  return path.split('.').reduce((o,k)=> (o && o[k]!==undefined) ? o[k] : undefined, obj);
+}
+
+function fmtVal(v, fmt){
+  if(v===undefined || v===null || v==='') return '&mdash;';
+  if(fmt==='money') return '$' + Number(v).toLocaleString();
+  if(fmt==='pct') return v + '%';
+  return String(v);
+}
+
+function dynamicCls(v){
+  const n = Number(v);
+  if(isNaN(n)) return 'cyan';
+  if(n>=80) return 'green';
+  if(n>=50) return 'amber';
+  return 'red';
+}
+
+function renderEmpty(){
+  document.getElementById('wrap').innerHTML = `
+    <div class="empty">
+      <h2>NO DATA RECEIVED</h2>
+      <p>Run an analysis in the Approval Chain war room, then relay it here.</p>
+      <div class="hdr-btns" style="justify-content:center;">
+        <a class="hbtn primary" href="approval-war-room.html">&#9989; Go to War Room</a>
+      </div>
+    </div>`;
+}
+
+function itemText(item){
+  if(typeof item === 'string') return item;
+  if(!item || typeof item !== 'object') return String(item);
+  const keys = ['message','description','reason','title','name','label','text','type'];
+  for(const k of keys){ if(item[k]) return String(item[k]); }
+  return JSON.stringify(item).slice(0,140);
+}
+
+function itemBadge(item){
+  if(!item || typeof item !== 'object') return null;
+  return item.status || item.severity || item.stage || item.priority || null;
+}
+
+function renderList(items, label, opts){
+  opts = opts || {};
+  if(!items || !items.length){
+    return `<div class="sec"><div class="sec-hdr">${label}</div><div class="no-items">No items.</div></div>`;
+  }
+  const rows = items.slice(0,12).map(it=>{
+    let main, badge;
+    if(opts.scoreItem){
+      main = it.label || it.name || it.id || 'Domain';
+      badge = (it.score!==undefined) ? it.score+'%' : null;
+    } else if(opts.systemItem){
+      main = it.name || it.id || 'System';
+      badge = it.status || null;
+      if(badge && badge==='healthy') return '';
+    } else {
+      main = itemText(it);
+      badge = itemBadge(it);
+    }
+    if(!main) return '';
+    return `<div class="list-row">${badge?`<span class="lbadge">${escapeHtml(String(badge))}</span>`:''}<span>${escapeHtml(String(main))}</span></div>`;
+  }).filter(Boolean).join('');
+  return `<div class="sec"><div class="sec-hdr">${label}</div>${rows || '<div class="no-items">All clear &mdash; no flagged items.</div>'}</div>`;
+}
+
+function render(){
+  const data = loadRelay();
+  if(!data){ renderEmpty(); return; }
+
+  document.getElementById('hdrSub').textContent = `Relayed ${data.timestamp ? new Date(data.timestamp).toLocaleString() : '&mdash;'}`;
+
+  const kpiBase = getPath(data, CFG.kpiPath) || {};
+  let html = '';
+
+  const tiles = CFG.kpis.map(k=>{
+    const raw = kpiBase[k.key];
+    const cls = k.cls === 'dynamic' ? dynamicCls(raw) : k.cls;
+    return { val: fmtVal(raw, k.fmt), lbl: k.label, cls };
+  });
+  html += `<div class="kpi-row">` + tiles.map(t=>`
+    <div class="kpi"><div class="kpi-val ${t.cls}">${t.val}</div><div class="kpi-lbl">${t.lbl}</div></div>
+  `).join('') + `</div>`;
+
+  let aiText = null;
+  for(const p of CFG.aiPaths){
+    const v = getPath(data, p);
+    if(v){ aiText = v; break; }
+  }
+  if(aiText){
+    html += `<div class="ai-box ${CFG.isExec?'hero':''}"><strong style="color:var(--cyan);font-family:'Orbitron',sans-serif;font-size:.65rem;letter-spacing:.1em;display:block;margin-bottom:8px;">${CFG.isExec?'EXECUTIVE RECOMMENDATION':'AI ANALYSIS'}</strong>${escapeHtml(aiText)}</div>`;
+  }
+
+  for(const l of CFG.lists){
+    const items = getPath(data, l.path);
+    html += renderList(items, l.label, l);
+  }
+
+  if(CFG.isExec){
+    html += `<div class="sec"><div class="sec-hdr">ACTIONS</div>
+      <div class="action-bar">
+        <button class="abtn approve" onclick="showToast('Marked reviewed &mdash; no downstream write in this demo build.')">&#10003; ACKNOWLEDGE</button>
+        <button class="abtn escalate" onclick="showToast('Escalation flagged &mdash; notify ops lead.')">&#8593; ESCALATE</button>
+      </div>
+    </div>`;
+  }
+
+  document.getElementById('wrap').innerHTML = html;
+}
+
+function escapeHtml(s){
+  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+}
 
-  <script>
-    const TSM_APPROVAL_RELAY
-    console.log("Executive portal initialized:", RELAY_KEY);
-  </script>
+render();
+window.addEventListener('storage', e => { if(e.key === RELAY_KEY_FALLBACK || e.key === 'TSM_EVENT_LOG') render(); });
+window.addEventListener('TSM_RELAY_EVENT', e => { if(e.detail && e.detail.domain === CFG.domain) render(); });
+</script>
 </body>
