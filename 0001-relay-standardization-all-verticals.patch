+<div class="hdr">
+  <div>
+    <div class="hdr-title" id="hdrTitle">&#9989; APPROVAL CHAIN EXECUTIVE PORTAL</div>
+    <div class="hdr-sub" id="hdrSub">Awaiting relay from the Approval Chain war room&hellip;</div>
+  </div>
+  <div class="hdr-btns">
+    <a class="hbtn" href="approval-war-room.html">&larr; War Room</a>
