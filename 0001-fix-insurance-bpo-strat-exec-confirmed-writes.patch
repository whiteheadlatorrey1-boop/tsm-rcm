From ebedb89e28ffc0a657ba4aaf7a67e96efd36962b Mon Sep 17 00:00:00 2001
From: Tron <tron@tsmconsultz.dev>
Date: Sat, 1 Aug 2026 05:30:47 +0000
Subject: [PATCH] fix: insurance and BPO never wrote STRAT_CONFIRMED /
 EXEC_CONFIRMED keys
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Follow-up to the chain-status-bar relay-key fix. Insurance and BPO had
no code path that ever set TSM_STRAT_CONFIRMED_* or
TSM_EXEC_CONFIRMED_*, so their chain bars could reach 'Relay fired ->
Strategist receiving' but never advance past it, even with a real
strategist synthesis and executive sign-off in hand.

insurance-strategist.html: escalateToExec() (the real 'strategist
confirms and routes to executive' action) now writes
TSM_STRAT_CONFIRMED_tsm-insurance, matching the vertical suffix the
chain-status-bar already reads.

insurance-executive-portal.html: the AUTHORIZE decision row's button
previously always linked back to the war room with no way to actually
confirm exec review. Added id="d1-action-btn", and once a strategist
relay is received (populateFromRelay) it's rewired to a real
tsmConfirmExec() action that writes TSM_EXEC_CONFIRMED_tsm-insurance
and disables itself after firing.

bpo-strategist.html: escalateToExec() now writes
TSM_STRAT_CONFIRMED_bpo alongside its existing collective-signal push.

bpo-executive-portal.html: markExecuted() was already a real,
user-triggered 'confirm execution' handler (updates status text,
disables the button) but never wrote the confirmed key. Added the
TSM_EXEC_CONFIRMED_bpo write inside it.

All four follow the Convention A shape used by the working
construction/legal/RE writers: {vertical, timestamp: Date.now()}.
Verified with node --check against every inline <script> block in all
4 files.

Out of scope: html/bpo-executive-portal.html (root-level, pre-migration
duplicate) was left untouched — it's flagged NO_INBOUND / dead in the
app rationalizer output and isn't the live BPO exec portal.
---
 .../bpo-war/bpo-executive-portal.html         | 12 +++++++++
 html/war-rooms/bpo-war/bpo-strategist.html    | 12 +++++++++
 .../insurance-executive-portal.html           | 25 ++++++++++++++++++-
 .../insure-war/insurance-strategist.html      | 12 +++++++++
 4 files changed, 60 insertions(+), 1 deletion(-)

diff --git a/html/war-rooms/bpo-war/bpo-executive-portal.html b/html/war-rooms/bpo-war/bpo-executive-portal.html
index c860aa44..ce696837 100644
--- a/html/war-rooms/bpo-war/bpo-executive-portal.html
+++ b/html/war-rooms/bpo-war/bpo-executive-portal.html
@@ -1164,6 +1164,18 @@ function markExecuted() {
   document.getElementById('markExecutedBtnBar').textContent = '✓ EXECUTION CONFIRMED';
   document.getElementById('markExecutedBtnBar').disabled = true;
 
+  // Real EXEC_CONFIRMED write (Convention A shape) — read by the war
+  // room's chain-status-bar and core/tsm-enforcer.js health audit.
+  // Previously this button updated its own label/status but never wrote
+  // TSM_EXEC_CONFIRMED_bpo, so the chain bar could never reach "Chain
+  // complete" even after a real executive sign-off.
+  try {
+    localStorage.setItem('TSM_EXEC_CONFIRMED_bpo', JSON.stringify({
+      vertical: 'bpo',
+      timestamp: Date.now()
+    }));
+  } catch(e) { console.warn('[exec-confirmed] bpo write error:', e); }
+
   if (window.TSMMemory) {
     // Stamp the final resolution so the next time this anomaly type arrives,
     // cross-upload insight can say "last time: X was chosen, outcome: executed"
diff --git a/html/war-rooms/bpo-war/bpo-strategist.html b/html/war-rooms/bpo-war/bpo-strategist.html
index 85199c56..eb8ad2fa 100644
--- a/html/war-rooms/bpo-war/bpo-strategist.html
+++ b/html/war-rooms/bpo-war/bpo-strategist.html
@@ -1168,6 +1168,18 @@ function escalateToExec(){
   if (window.TSMMemory) TSMMemory.timeline('Escalating to Executive Portal');
   resolveIncidentInMemory();
   try { fetch('/api/collective/signal', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ vertical:'bpo', warRoom:'BPO Strategist V2', signal:'Strategy packaged — escalating to Executive Portal for approval', severity:'HIGH', riskLevel: warData?.riskLevel || 'RISK', source: window.location.pathname }) }); } catch(e) {}
+
+  // Real strategist-confirmed signal (Convention A shape) — read by the
+  // war room's chain-status-bar and core/tsm-enforcer.js health audit.
+  // Previously nothing ever wrote TSM_STRAT_CONFIRMED_bpo, so the chain
+  // bar could reach "Relay fired" but never "Strategist confirmed".
+  try {
+    localStorage.setItem('TSM_STRAT_CONFIRMED_bpo', JSON.stringify({
+      vertical: 'bpo',
+      timestamp: Date.now()
+    }));
+  } catch(e) { console.warn('[strat-confirmed] bpo write error:', e); }
+
   window.location.href = '/html/war-rooms/bpo-war/bpo-executive-portal.html';
 }
 
diff --git a/html/war-rooms/insure-war/insurance-executive-portal.html b/html/war-rooms/insure-war/insurance-executive-portal.html
index ceaee18c..27210dcd 100644
--- a/html/war-rooms/insure-war/insurance-executive-portal.html
+++ b/html/war-rooms/insure-war/insurance-executive-portal.html
@@ -499,7 +499,7 @@ body::before{content:'';position:fixed;top:0;right:0;width:600px;height:400px;ba
     <div><div class="d-title" id="d1-title">Run War Room analysis to populate decisions</div><div class="d-sub" id="d1-sub">Load a claim/policy document in the Insurance War Room and fire 6-engine analysis</div></div>
     <div class="d-amount" id="d1-amount">—</div>
     <div class="d-urgency" id="d1-urgency">—</div>
-    <button class="d-action" onclick="nav('insurance-war-room.html')">WAR ROOM</button>
+    <button class="d-action" id="d1-action-btn" onclick="nav('insurance-war-room.html')">WAR ROOM</button>
   </div>
   <div class="decision-row">
     <div class="d-badge badge-esc">ESCALATE</div>
@@ -814,6 +814,29 @@ function populateFromRelay(d) {
   document.getElementById('sbRelay').textContent = docType + ' · Relay active';
   document.getElementById('syncLabel').textContent = 'Synced ' + new Date().toLocaleTimeString('en-US',{hour12:false});
   document.getElementById('bncaStamp').textContent = 'Last run ' + new Date().toLocaleTimeString('en-US',{hour12:false});
+
+  // Real EXEC_CONFIRMED write (Convention A shape) — read by the war
+  // room's chain-status-bar and core/tsm-enforcer.js health audit.
+  // Previously the AUTHORIZE row's button always linked back to the war
+  // room; nothing ever set TSM_EXEC_CONFIRMED_tsm-insurance through any
+  // code path. Once a strategist relay lands, rewire it to a real
+  // authorization action instead.
+  const d1Btn = document.getElementById('d1-action-btn');
+  if (d1Btn && !d1Btn.disabled) {
+    d1Btn.textContent = 'AUTHORIZE';
+    d1Btn.onclick = tsmConfirmExec;
+  }
+}
+
+function tsmConfirmExec(){
+  try {
+    localStorage.setItem('TSM_EXEC_CONFIRMED_tsm-insurance', JSON.stringify({
+      vertical: 'tsm-insurance',
+      timestamp: Date.now()
+    }));
+  } catch(e) { console.warn('[exec-confirmed] insurance write error:', e); }
+  const btn = document.getElementById('d1-action-btn');
+  if (btn) { btn.textContent = 'AUTHORIZED \u2713'; btn.disabled = true; }
 }
 
 // ═══════════════════════════════════════════════════
diff --git a/html/war-rooms/insure-war/insurance-strategist.html b/html/war-rooms/insure-war/insurance-strategist.html
index b72e7dde..1e12f420 100644
--- a/html/war-rooms/insure-war/insurance-strategist.html
+++ b/html/war-rooms/insure-war/insurance-strategist.html
@@ -771,6 +771,18 @@ function escalateToExec(){
     }
   } catch(e) { console.warn('[collective-signal] insurance strategist push error:', e); }
   // ── END COLLECTIVE SIGNAL PUSH ───────────────────────────────────────
+
+  // Real strategist-confirmed signal (Convention A shape) — read by the
+  // war room's chain-status-bar and core/tsm-enforcer.js health audit.
+  // Previously nothing ever wrote TSM_STRAT_CONFIRMED_tsm-insurance, so the
+  // chain bar could reach "Relay fired" but never "Strategist confirmed".
+  try {
+    localStorage.setItem('TSM_STRAT_CONFIRMED_tsm-insurance', JSON.stringify({
+      vertical: 'tsm-insurance',
+      timestamp: Date.now()
+    }));
+  } catch(e) { console.warn('[strat-confirmed] insurance write error:', e); }
+
   setTimeout(()=>nav('insurance-executive-portal.html'),400);
 }
 
