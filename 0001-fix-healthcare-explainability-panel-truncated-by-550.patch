From b909d11969d709ff1e2a41622496c0a66b055354 Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic-session.local>
Date: Sun, 2 Aug 2026 07:00:59 +0000
Subject: [PATCH] fix(healthcare): explainability panel truncated by 550-token
 cap on /api/hc/query

- server.js: bump default max_tokens 550 -> 1800 so the AI has room
  to finish the ===JSON=== explainability block after the ===BRIEF===
  section, not just the brief text.
- hc-main-strategist.html: when the JSON block is still missing or
  fails to parse (jsonMatch null, or JSON.parse throws), show an
  honest error state in the Why Does The AI Believe This panel
  instead of leaving it silently frozen on the pre-run placeholder.
---
 html/healthcare/hc-main-strategist.html | 7 +++++++
 server.js                               | 2 +-
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/html/healthcare/hc-main-strategist.html b/html/healthcare/hc-main-strategist.html
index 4030fc1..5d0db15 100644
--- a/html/healthcare/hc-main-strategist.html
+++ b/html/healthcare/hc-main-strategist.html
@@ -1051,7 +1051,14 @@ async function callClaudeWithExplain(userMsg, outEl, thinkEl, errEl){
           // ── END SENTINEL PUSH ───────────────────────────────────────────
         } catch(je){
           console.warn('HC Explain JSON parse error:', je);
+          document.getElementById('hcExplainSources').innerHTML = '<div style="color:var(--red);font-family:\'JetBrains Mono\',monospace;font-size:.63rem">AI response was cut off before the explainability data finished — try again.</div>';
+          document.getElementById('hcReasoningBox').innerHTML = '<div style="color:var(--red)">Reasoning chain unavailable (incomplete AI response).</div>';
+          document.getElementById('hcExplainActions').innerHTML = '<div style="color:var(--red);font-family:\'JetBrains Mono\',monospace;font-size:.63rem">Action owners unavailable — rerun analysis.</div>';
         }
+      } else {
+        document.getElementById('hcExplainSources').innerHTML = '<div style="color:var(--red);font-family:\'JetBrains Mono\',monospace;font-size:.63rem">AI response was cut off before the explainability data started — try again.</div>';
+        document.getElementById('hcReasoningBox').innerHTML = '<div style="color:var(--red)">Reasoning chain unavailable (incomplete AI response).</div>';
+        document.getElementById('hcExplainActions').innerHTML = '<div style="color:var(--red);font-family:\'JetBrains Mono\',monospace;font-size:.63rem">Action owners unavailable — rerun analysis.</div>';
       }
     } else if(data.error){
       throw new Error(data.error);
diff --git a/server.js b/server.js
index bdb6826..083e6f2 100644
--- a/server.js
+++ b/server.js
@@ -327,7 +327,7 @@ app.post('/api/hc/query', async (req, res) => {
     var sys = body.system || SP.healthcare;
     var msg = body.message || body.question || body.query;
     if (!msg) return res.status(400).json({ ok: false, error: 'Query required' });
-    var a = await groqChat(sys, msg, body.maxTokens || 550);
+    var a = await groqChat(sys, msg, body.maxTokens || 1800);
     console.log('[HC QUERY DEBUG] a =', JSON.stringify(a));
     return res.json({ ok: true, output: a, answer: a, reply: a, content: a, createdAt: new Date().toISOString() });
   } catch (e) { console.log('[HC ERROR]', e.message); return res.status(500).json({ ok: false, error: e.message }); }
