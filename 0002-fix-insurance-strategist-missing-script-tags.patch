   } catch(e){ console.warn('Insurance issue pack error:',e); }
 })();
 </script>
+<script>
 /**
  * TSM MISSION GUIDE — Inlined
  */// v3
@@ -1241,6 +1242,7 @@ function insXPParseExplain(raw){
 </script>
 <script src="/html/tsm-insurance/public/js/tsm-mission-guide.js"></script>
 
