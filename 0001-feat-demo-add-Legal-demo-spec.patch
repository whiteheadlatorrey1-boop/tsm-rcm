From 329717b3de3307739c9ebc89aa3876fefff5e308 Mon Sep 17 00:00:00 2001
From: Latorrey Whitehead <torreyw94@tsmatter.com>
Date: Sun, 2 Aug 2026 18:26:15 +0000
Subject: [PATCH] feat(demo): add Legal demo spec

Source-verified against real ids/onclick handlers/functions in
legal-war-room.html / legal-main-strategist.html /
legal-executive-portal.html: sample matter load -> FIRE ALL 6
ENGINES (#fireBtn, #eo1-#eo5) -> escalateToChief() -> Case
Strategist -> #escalate-btn (writeExecRelay) -> Executive Portal
(.kpi-row on DOMContentLoaded). Exercises the Executive Portal
link/relay-key fix already merged in 66100937, not the retired
ep1.html mock. Not yet live-Playwright-verified (sandbox hits the
same chrome-headless-shell 403 as Codespace) -- run once in
Codespaces and correct any selector drift before treating as final.
---
 demo/legal-demo.json              | 21 +++++++++++++++++++++
 tests/e2e/demo/legal-demo.spec.js | 20 ++++++++++++++++++++
 2 files changed, 41 insertions(+)
 create mode 100644 demo/legal-demo.json
 create mode 100644 tests/e2e/demo/legal-demo.spec.js

diff --git a/demo/legal-demo.json b/demo/legal-demo.json
new file mode 100644
index 00000000..4a826f41
--- /dev/null
+++ b/demo/legal-demo.json
@@ -0,0 +1,21 @@
+{
+  "vertical": "legal",
+  "note": "Source-verified 2026-08-02 against whiteheadlatorrey1-boop/tsm-rcm (html/war-rooms/legal-war/legal-war-room.html + legal-main-strategist.html + legal-executive-portal.html) by reading real ids/onclick handlers/functions directly -- NOT live-verified via Playwright (this sandbox hits the same chrome-headless-shell 403 as the Codespace). Legal War Room uses the FinOps/Insurance-style 6-engine grid: sample buttons (#smp-complaint etc.) populate #docPaste, #fireBtn (disabled until a doc is loaded) runs fireEngines() which fills #eo1..#eo5 in sequence, then escalateToChief() writes TSM_CURE_RELAY + pushes the collective signal and navigates to legal-main-strategist.html (labelled CASE STRATEGIST in-app). legal-main-strategist.html's own #escalate-btn (onclick writeExecRelay(event)) forwards to legal-executive-portal.html (labelled CHIEF STRATEGIST in-app), which mounts its KPI row (.kpi-row) and explainability panels on DOMContentLoaded from the relay. This exercises the Executive Portal link + relay key fix already merged (commit 66100937) rather than the old ep1.html mock. Run once in Codespaces and correct any selector drift before treating as final.",
+  "steps": [
+    { "shot": "001-war-room-load", "goto": "/html/war-rooms/legal-war/legal-war-room.html", "waitMs": 1500 },
+
+    { "shot": "002-load-sample-matter", "click": "#smp-complaint", "waitFor": "#docPaste", "waitMs": 800 },
+
+    { "shot": "003-fire-all-engines", "click": "#fireBtn", "waitFor": "#eo1", "waitMs": 5000 },
+
+    { "shot": "004-engine-outputs", "waitFor": "#eo5", "waitMs": 1500 },
+
+    { "shot": "005-escalate-to-case-strategist", "click": "button.btn.btn-fire", "waitMs": 1500 },
+
+    { "shot": "006-case-strategist-load", "waitFor": ".tn-link.active", "waitMs": 1000 },
+
+    { "shot": "007-escalate-to-chief-strategist", "click": "#escalate-btn", "waitMs": 1500 },
+
+    { "shot": "008-exec-portal-kpis", "waitFor": ".kpi-row", "waitMs": 1000 }
+  ]
+}
diff --git a/tests/e2e/demo/legal-demo.spec.js b/tests/e2e/demo/legal-demo.spec.js
new file mode 100644
index 00000000..7a196a45
--- /dev/null
+++ b/tests/e2e/demo/legal-demo.spec.js
@@ -0,0 +1,20 @@
+const { test } = require('@playwright/test');
+const path = require('path');
+const { runStory, loadStory } = require('../../../demo/demo-engine');
+
+// Point this at your running TSM server (Codespace forwarded port or localhost).
+const BASE_URL = process.env.TSM_BASE_URL || 'http://localhost:8080';
+
+test('Legal executive demo', async ({ page }) => {
+  await page.setViewportSize({ width: 1920, height: 1080 });
+  test.setTimeout(120_000);
+
+  const story = loadStory(path.join(__dirname, '../../../demo/legal-demo.json'));
+  const outDir = path.join(__dirname, 'screenshots', 'legal');
+
+  await runStory(page, {
+    steps: story.steps,
+    outDir,
+    baseURL: BASE_URL,
+  });
+});
