+// Business Impact Delta — deterministic, no LLM-guessed dollars. Uses the
+// same shared TSMBNCAExposureEngine as Insurance/RE/Healthcare/BPO/FinOps;
+// only the inputs differ. Severity and the deadline signal are both derived
+// from real per-record data (worst compliance due date, worst SLA breach) —
+// same records already used by fireCapabilitySweep_HotelOps above.
+function severityFromOpsSignals(worstMaint, worstCompliance){
+  const dueDays = worstCompliance && Number.isFinite(worstCompliance.due_in_days) ? worstCompliance.due_in_days : null;
+  const hoursOver = worstMaint && Number.isFinite(worstMaint.hours_over) ? worstMaint.hours_over : null;
+  if ((dueDays !== null && dueDays <= 7) || (hoursOver !== null && hoursOver >= 48)) return 'CRIT';
+  if ((dueDays !== null && dueDays <= 14) || (hoursOver !== null && hoursOver >= 24)) return 'HIGH';
+  if ((dueDays !== null && dueDays <= 30) || (hoursOver !== null && hoursOver > 0)) return 'MED';
+  return 'LOW';
+}
+
+function renderBusinessImpactDelta(data){
+  const fin = data.financials || {};
+  const baseExposure = Number(fin.ota_overcharge_period) || 0;
+  if (!baseExposure || !window.TSMBNCAExposureEngine) {
+    return `<div class="sec"><div class="sec-hdr"><span class="lbl">BUSINESS IMPACT DELTA</span></div><div class="no-items">No quantifiable OTA overcharge exposure reported for this relay.</div></div>`;
+  }
+  const worstMaint = (data.maintenance_breaches || []).slice().sort((a,b) => b.hours_over - a.hours_over)[0];
+  const worstCompliance = (data.compliance_risk || []).slice().sort((a,b) => a.due_in_days - b.due_in_days)[0];
+  const severity = severityFromOpsSignals(worstMaint, worstCompliance);
+  const daysUntilDeadline = worstCompliance && Number.isFinite(worstCompliance.due_in_days) ? worstCompliance.due_in_days : 0;
+  const impact = window.TSMBNCAExposureEngine.project({
+    baseExposure, severity,
+    confidence: 70, // no distinct AI-confidence signal in this vertical's relay yet; engine's own documented neutral default
+    daysUntilDeadline
+  });
+  const fmt = n => '$' + Math.round(n).toLocaleString('en-US');
+  return `<div class="sec">
+    <div class="sec-hdr"><span class="lbl">BUSINESS IMPACT DELTA</span><span class="sec-hdr-note">OTA overcharge exposure &middot; deterministic projection</span></div>
+    <div class="tsm-delta-row">
+      <div class="tsm-delta-box tsm-delta-no"><div class="tsm-delta-lbl">No Action</div><div class="tsm-delta-val">${fmt(impact.ifIgnored.exposure)}</div></div>
+      <div class="tsm-delta-box tsm-delta-act"><div class="tsm-delta-lbl">With Action</div><div class="tsm-delta-val">${fmt(impact.ifActed.exposure)}</div></div>
+    </div>
+    <div class="tsm-recovery">${escapeHtml(impact.urgencyWindow)} &middot; ${escapeHtml(impact.methodology)}</div>
+  </div>`;
+}
+
 function renderLiveMissionsRegister(){
   if(!window.TSMMissionStore) return '';
   const missions = window.TSMMissionStore.listMissions({ vertical: 'hotelops' });
@@ -426,6 +476,7 @@ function render(){
