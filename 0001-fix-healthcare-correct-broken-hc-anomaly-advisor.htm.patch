From 2029d1d53f7d8645cbed89ba5626f4db0a17ae2f Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic-session.local>
Date: Sun, 2 Aug 2026 06:40:48 +0000
Subject: [PATCH] fix(healthcare): correct broken hc-anomaly-advisor.html
 relative path

Anomaly Advisor button/panel resolved to /html/healthcare/hc-anomaly-advisor.html
(same directory as hc-denial-war-room.html) but the file actually lives at
/html/healthcare/hc-academy/hc-anomaly-advisor.html. Fixed both references.
---
 html/healthcare/hc-denial-war-room.html           | 4 ++--
 html/war-rooms/health-war/hc-denial-war-room.html | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/html/healthcare/hc-denial-war-room.html b/html/healthcare/hc-denial-war-room.html
index d3651a44..25e1ef33 100644
--- a/html/healthcare/hc-denial-war-room.html
+++ b/html/healthcare/hc-denial-war-room.html
@@ -2217,7 +2217,7 @@ function openAnomalyAdvisor() {
     const docText = docEl ? docEl.value : '';
     sessionStorage.setItem('tsmHcWarRoom', JSON.stringify({ docText, selectedDocType: 'HC Denial', timestamp: Date.now() }));
   } catch(e) {}
-  window.open('hc-anomaly-advisor.html', '_blank');
+  window.open('/html/healthcare/hc-academy/hc-anomaly-advisor.html', '_blank');
 }
 
 // ── HC DENIAL APP ROUTING ────────────────────────────────────
@@ -2353,7 +2353,7 @@ function showAnomalyAdvisorPanel(outputs, docText) {
     <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-bottom:1px solid #1ee8b633;background:#0d1a0d;">
       <span style="color:#1ee8b6;font-size:11px;font-weight:700;letter-spacing:2px;">⬡ ANOMALY ADVISOR — FIELD DEFECT SCAN</span>
       <div style="display:flex;gap:8px;align-items:center;">
-        <button onclick="window.open('hc-anomaly-advisor.html','_blank')" style="background:#1ee8b620;border:1px solid #1ee8b6;color:#1ee8b6;font-size:9px;padding:3px 8px;cursor:pointer;font-family:inherit;letter-spacing:1px;">FULL REPORT ↗</button>
+        <button onclick="window.open('/html/healthcare/hc-academy/hc-anomaly-advisor.html','_blank')" style="background:#1ee8b620;border:1px solid #1ee8b6;color:#1ee8b6;font-size:9px;padding:3px 8px;cursor:pointer;font-family:inherit;letter-spacing:1px;">FULL REPORT ↗</button>
         <button onclick="document.getElementById('anomaly-slide-panel').remove()" style="background:transparent;border:none;color:#666;font-size:16px;cursor:pointer;line-height:1;padding:0 2px;">✕</button>
       </div>
     </div>
diff --git a/html/war-rooms/health-war/hc-denial-war-room.html b/html/war-rooms/health-war/hc-denial-war-room.html
index d3651a44..25e1ef33 100644
--- a/html/war-rooms/health-war/hc-denial-war-room.html
+++ b/html/war-rooms/health-war/hc-denial-war-room.html
@@ -2217,7 +2217,7 @@ function openAnomalyAdvisor() {
     const docText = docEl ? docEl.value : '';
     sessionStorage.setItem('tsmHcWarRoom', JSON.stringify({ docText, selectedDocType: 'HC Denial', timestamp: Date.now() }));
   } catch(e) {}
-  window.open('hc-anomaly-advisor.html', '_blank');
+  window.open('/html/healthcare/hc-academy/hc-anomaly-advisor.html', '_blank');
 }
 
 // ── HC DENIAL APP ROUTING ────────────────────────────────────
@@ -2353,7 +2353,7 @@ function showAnomalyAdvisorPanel(outputs, docText) {
     <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-bottom:1px solid #1ee8b633;background:#0d1a0d;">
       <span style="color:#1ee8b6;font-size:11px;font-weight:700;letter-spacing:2px;">⬡ ANOMALY ADVISOR — FIELD DEFECT SCAN</span>
       <div style="display:flex;gap:8px;align-items:center;">
-        <button onclick="window.open('hc-anomaly-advisor.html','_blank')" style="background:#1ee8b620;border:1px solid #1ee8b6;color:#1ee8b6;font-size:9px;padding:3px 8px;cursor:pointer;font-family:inherit;letter-spacing:1px;">FULL REPORT ↗</button>
+        <button onclick="window.open('/html/healthcare/hc-academy/hc-anomaly-advisor.html','_blank')" style="background:#1ee8b620;border:1px solid #1ee8b6;color:#1ee8b6;font-size:9px;padding:3px 8px;cursor:pointer;font-family:inherit;letter-spacing:1px;">FULL REPORT ↗</button>
         <button onclick="document.getElementById('anomaly-slide-panel').remove()" style="background:transparent;border:none;color:#666;font-size:16px;cursor:pointer;line-height:1;padding:0 2px;">✕</button>
       </div>
     </div>
-- 
