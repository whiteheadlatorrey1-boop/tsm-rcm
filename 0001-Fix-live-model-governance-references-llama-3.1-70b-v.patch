From: Latorrey Whitehead <torreyw94@tsmatter.com>
Date: Wed, 5 Aug 2026 02:05:41 +0000
Subject: [PATCH] Fix live model-governance references: llama-3.1-70b-versatile
 (dead since 01/24/25) and llama-3.1-8b-instant (deprecated, dies 08/16/26)

---
 html/shared/runtime/model-governance/model-registry.js | 4 ++--
 server/enterprise-lab/twins-router.js                  | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/html/shared/runtime/model-governance/model-registry.js b/html/shared/runtime/model-governance/model-registry.js
index d67d61e8..77c70322 100644
--- a/html/shared/runtime/model-governance/model-registry.js
+++ b/html/shared/runtime/model-governance/model-registry.js
@@ -9,7 +9,7 @@
 const MODELS = {
   'groq:llama-3.1-70b': {
     provider: 'groq',
-    modelId: 'llama-3.1-70b-versatile',
+    modelId: 'openai/gpt-oss-120b',
     approvedFor: ['general', 'strategist', 'situation-room', 'collective-bnca', 'wip-command-center'],
     costPer1kTokensUsd: 0.00059,
     avgLatencyMs: 700,
@@ -17,7 +17,7 @@ const MODELS = {
   },
   'groq:llama-3.1-8b': {
     provider: 'groq',
-    modelId: 'llama-3.1-8b-instant',
+    modelId: 'openai/gpt-oss-20b',
     approvedFor: ['general', 'quick-classification'],
     costPer1kTokensUsd: 0.00005,
     avgLatencyMs: 250,
diff --git a/server/enterprise-lab/twins-router.js b/server/enterprise-lab/twins-router.js
index db8a5295..6d4aef15 100644
--- a/server/enterprise-lab/twins-router.js
+++ b/server/enterprise-lab/twins-router.js
@@ -367,7 +367,7 @@ router.post('/analytics/stop', (req, res) => {
 // No keyword-match fallback by design — if the AI call fails, the
 // widget reports that rather than silently guessing.
 
-const AI_WIDGET_MODELS = ['openai/gpt-oss-120b', 'llama-3.1-8b-instant'];
+const AI_WIDGET_MODELS = ['openai/gpt-oss-120b', 'openai/gpt-oss-20b'];
 
 async function matchScenarioToQuery(query, entries) {
   const groqKey = process.env.GROQ_KEY || process.env.GROQ_API_KEY;
