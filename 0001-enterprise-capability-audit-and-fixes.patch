index 00000000..3437b3a9
--- /dev/null
+++ b/scripts/enterprise-capability-audit.js
@@ -0,0 +1,262 @@
+#!/usr/bin/env node
+/**
+ * scripts/enterprise-capability-audit.js
+ *
+ * Data layer for the (not-yet-built) Enterprise Capability Matrix.
+ *
+ * The matrix idea from the reference email was "10 capabilities x 7
+ * verticals". Neither number is real: WAR_ROOM_ROUTES currently registers
+ * 15+ distinct industry verticals (Schools isn't even in war-room-prep.html's
+ * own SECTOR_IDS tracker yet) and architecture/kernel/phases.json currently
+ * defines 12 generic capability war rooms, not 10. Hardcoding either count
+ * into a matrix page would make it stale the next time a vertical or phase
+ * is added -- which happens most sessions.
+ *
+ * So instead of hand-maintaining a grid, this script re-derives ground truth
+ * every time it's run, from the two registries that already exist:
+ *   - html/tsm-doc-search-multi.html's WAR_ROOM_ROUTES  (industry verticals)
+ *   - architecture/kernel/phases.json's `phases` array   (generic capabilities)
+ *
+ * It does NOT fabricate a per-vertical-per-capability integration matrix --
+ * that data doesn't exist anywhere in the codebase yet (the two systems are
+ * disjoint; phases.json's own note says so explicitly). What it DOES do is
+ * produce real, verifiable facts about each side, plus the one honest
+ * cross-reference check that's currently possible: whether the "same" page
+ * is registered in both places under different keys, and whether every
+ * registered path actually exists on disk.
+ *
+ * Usage: node scripts/enterprise-capability-audit.js [--root=.] [--json]
+ */
+const fs = require('fs');
+const path = require('path');
+
+const args = process.argv.slice(2);
+const ROOT = path.resolve((args.find(a => a.startsWith('--root=')) || '--root=.').split('=')[1]);
+const JSON_OUT = args.includes('--json');
+
+const HUB_FILE = path.join(ROOT, 'html/tsm-doc-search-multi.html');
+const PHASES_FILE = path.join(ROOT, 'architecture/kernel/phases.json');
+const PREP_FILE = path.join(ROOT, 'html/war-rooms/war-room-prep.html');
+
+// ── 1. Parse WAR_ROOM_ROUTES entries out of the hub file ───────────────────
+// Format seen in the file (both the main object and the later Object.assign
+// block use the same shape):
+//   'key': { label:'Label Text', url:'/html/...', relay:'...', autoKey:'...' },
+const ROUTE_RE = /'([a-z0-9_-]+)':\s*\{\s*label:\s*'([^']*)',\s*url:\s*'([^']*)'/g;
+
+function parseRoutes(text) {
+  const routes = [];
+  let m;
+  while ((m = ROUTE_RE.exec(text))) {
+    routes.push({ key: m[1], label: m[2], url: m[3] });
+  }
+  return routes;
+}
+
+function dedupeByUrl(routes) {
+  const byUrl = new Map();
+  for (const r of routes) {
+    if (!byUrl.has(r.url)) byUrl.set(r.url, { label: r.label, url: r.url, keys: [] });
+    byUrl.get(r.url).keys.push(r.key);
+  }
+  return [...byUrl.values()];
+}
+
+// ── 4. Classify each war-room page ─────────────────────────────────────
+// war-room-prep.html's SECTOR_IDS is a manual QA checklist that was only
+// ever meant to cover the customer-facing industry verticals -- not the
+// generic SAP-style capability rooms (CRM, CPQ, MDM, etc.) or the
+// operational/incident war rooms (Honeywell, HotelOps, NOC, Logistics).
+// Explicit mapping beats fuzzy string matching (e.g. "Mortgage Command"
+// vs id 'mtg' doesn't share a clean substring) -- documented here instead
+// of guessed at runtime.
+const SECTOR_ID_TO_LABEL = {
+  hc: 'HC Denial War Room',
+  finops: 'FinOps War Room',
+  ins: 'Insurance War Room',
+  con: 'Construction War Room',
+  legal: 'Legal War Room',
+  re: 'Real Estate War Room',
+  bpo: 'BPO War Room',
+  mtg: 'Mortgage Command',
+};
+// Every industry vertical currently registered in the hub, whether or not
+// war-room-prep.html's SECTOR_IDS has caught up to it yet.
+const INDUSTRY_VERTICAL_LABELS = new Set([
+  ...Object.values(SECTOR_ID_TO_LABEL),
+  'Schools Command', // registered in the hub, confirmed absent from SECTOR_IDS
+]);
+const LABEL_TO_SECTOR_ID = new Map(Object.entries(SECTOR_ID_TO_LABEL).map(([id, label]) => [label, id]));
+
+function classify(label) {
+  if (INDUSTRY_VERTICAL_LABELS.has(label)) return 'industry-vertical';
+  if (/Honeywell|HotelOps|NOC|Logistics|Supplier\/Vendor/.test(label)) return 'operational';
+  return 'capability'; // O2C, CRM, CPQ, Catalog, Approval, MDM, Integration Hub, Governance, Digital Twin
+}
+
+function fileExists(relUrl) {
+  // urls are absolute-from-repo-root, e.g. /html/war-rooms/legal-war/legal-war-room.html
+  const p = path.join(ROOT, relUrl.replace(/^\//, ''));
+  return fs.existsSync(p);
+}
+
+function findSiblings(relUrl) {
+  const abs = path.join(ROOT, relUrl.replace(/^\//, ''));
+  const dir = path.dirname(abs);
+  if (!fs.existsSync(dir)) return { hasStrategist: false, hasExecPortal: false, dirFiles: [] };
+  const files = fs.readdirSync(dir).filter(f => f.endsWith('.html'));
+  return {
+    hasStrategist: files.some(f => /strategist/i.test(f)),
+    hasExecPortal: files.some(f => /exec(utive)?-?portal/i.test(f)),
+    dirFiles: files,
+  };
+}
+
+// ── 2. Parse phases.json ────────────────────────────────────────────────
+function loadPhases() {
+  const d = JSON.parse(fs.readFileSync(PHASES_FILE, 'utf8'));
+  return { meta: { version: d.version, lastAudit: d.lastAudit, note: d.note }, phases: d.phases };
+}
+
+// ── 3. Parse war-room-prep.html's SECTOR_IDS (the vertical QA tracker) ────
+function loadSectorIds() {
+  const text = fs.readFileSync(PREP_FILE, 'utf8');
+  const m = text.match(/const SECTOR_IDS\s*=\s*\[([^\]]*)\]/);
+  if (!m) return [];
+  return m[1].split(',').map(s => s.trim().replace(/^'|'$/g, '')).filter(Boolean);
+}
+
+function main() {
+  const hubText = fs.readFileSync(HUB_FILE, 'utf8');
+  const rawRoutes = parseRoutes(hubText);
+  const verticals = dedupeByUrl(rawRoutes);
+  const { meta: phasesMeta, phases } = loadPhases();
+  const sectorIds = loadSectorIds();
+
+  // Which capability entryPoints are ALSO registered as a WAR_ROOM_ROUTES url?
+  // That's the one real, checkable cross-reference between the two systems.
+  const verticalUrlSet = new Set(verticals.map(v => v.url));
+
+  const capabilityRows = phases.map(p => {
+    const entryUrl = '/html/' + p.entryPoint.replace(/^\//, '');
+    return {
+      id: p.id,
+      name: p.name,
+      category: p.category,
+      status: p.status,
+      progress: p.progress,
+      entryPoint: p.entryPoint,
+      entryPointExists: fileExists(entryUrl),
+      registeredInHub: verticalUrlSet.has(entryUrl),
+      verified: p.verified || null,
+    };
+  });
+
+  const verticalRows = verticals.map(v => {
+    const sib = findSiblings(v.url);
+    const kind = classify(v.label);
+    const sectorId = LABEL_TO_SECTOR_ID.get(v.label) || null;
+    return {
+      label: v.label,
+      url: v.url,
+      keys: v.keys,
+      kind, // 'industry-vertical' | 'operational' | 'capability'
+      fileExists: fileExists(v.url),
+      hasStrategist: sib.hasStrategist,
+      hasExecPortal: sib.hasExecPortal,
+      // Tracker coverage is only meaningful for industry verticals --
+      // war-room-prep.html's SECTOR_IDS was never meant to include the
+      // capability rooms or operational/incident war rooms.
+      inSectorTracker: kind === 'industry-vertical' ? sectorIds.includes(sectorId) : null,
+    };
+  }).sort((a, b) => a.label.localeCompare(b.label));
+
+  const report = {
+    generatedAt: new Date().toISOString(),
+    phasesJsonMeta: phasesMeta,
+    summary: {
+      totalRegisteredWarRoomEntries: rawRoutes.length,
+      totalUniqueWarRoomPages: verticals.length,
+      totalCapabilityPhases: phases.length,
+      capabilityPhasesAlsoInHub: capabilityRows.filter(c => c.registeredInHub).length,
+      verticalsByKind: {
+        'industry-vertical': verticalRows.filter(v => v.kind === 'industry-vertical').length,
+        operational: verticalRows.filter(v => v.kind === 'operational').length,
+        capability: verticalRows.filter(v => v.kind === 'capability').length,
+      },
+      industryVerticalsMissingFromSectorTracker: verticalRows.filter(v => v.kind === 'industry-vertical' && v.inSectorTracker === false).map(v => v.label),
+      brokenPaths: [...verticalRows.filter(v => !v.fileExists).map(v => v.url),
+                    ...capabilityRows.filter(c => !c.entryPointExists).map(c => c.entryPoint)],
+    },
+    verticals: verticalRows,
+    capabilities: capabilityRows,
+  };
+
+  if (JSON_OUT) {
+    console.log(JSON.stringify(report, null, 2));
+    return report;
+  }
+
+  console.log('========== Enterprise Capability Audit (data layer) ==========');
+  console.log(`Generated: ${report.generatedAt}`);
+  console.log(`phases.json: version ${phasesMeta.version}, last audit ${phasesMeta.lastAudit}\n`);
+
+  console.log(`Unique war-room pages registered in the hub: ${report.summary.totalUniqueWarRoomPages} (from ${report.summary.totalRegisteredWarRoomEntries} route entries)`);
+  console.log(`  - Industry verticals: ${report.summary.verticalsByKind['industry-vertical']}`);
+  console.log(`  - Operational/incident war rooms: ${report.summary.verticalsByKind.operational}`);
+  console.log(`  - Generic capability rooms (also in phases.json): ${report.summary.verticalsByKind.capability}`);
+  console.log(`Generic capability phases in phases.json:     ${report.summary.totalCapabilityPhases}`);
+  console.log(`Capability phases ALSO registered in the hub: ${report.summary.capabilityPhasesAlsoInHub} / ${report.summary.totalCapabilityPhases}\n`);
+
+  if (report.summary.industryVerticalsMissingFromSectorTracker.length) {
+    console.log(`Industry verticals registered in the hub but NOT in war-room-prep.html's SECTOR_IDS tracker:`);
+    report.summary.industryVerticalsMissingFromSectorTracker.forEach(v => console.log(`  - ${v}`));
+    console.log('');
+  } else {
+    console.log(`All industry verticals are present in war-room-prep.html's SECTOR_IDS tracker.\n`);
+  }
+
+  if (report.summary.brokenPaths.length) {
+    console.log(`BROKEN PATHS (registered but file missing on disk):`);
+    report.summary.brokenPaths.forEach(p => console.log(`  - ${p}`));
+    console.log('');
+  } else {
+    console.log('No broken paths found -- every registered vertical and capability entry point resolves to a real file.\n');
+  }
+
+  console.log('--- Verticals (from WAR_ROOM_ROUTES) ---');
+  verticalRows.forEach(v => {
+    const flags = [
+      v.fileExists ? 'file-ok' : 'FILE-MISSING',
+      v.hasStrategist ? 'strategist' : 'no-strategist',
+      v.hasExecPortal ? 'exec-portal' : 'no-exec-portal',
+      v.inSectorTracker ? 'tracked' : 'UNTRACKED',
+    ].join(', ');
+    console.log(`  ${v.label.padEnd(32)} [${flags}]`);
+  });
+
+  console.log('\n--- Capabilities (from phases.json) ---');
+  capabilityRows.forEach(c => {
+    const flags = [
+      c.entryPointExists ? 'file-ok' : 'FILE-MISSING',
+      c.registeredInHub ? 'in-hub' : 'NOT-IN-HUB',
+      `status:${c.status}`,
+      `progress:${c.progress}%`,
+    ].join(', ');
+    console.log(`  ${c.name.padEnd(32)} [${flags}]`);
+  });
+
+  console.log('\nNote: this is ground-truth data collection only. It does NOT compute a');
+  console.log('per-vertical-per-capability matrix, because no data source in the repo');
+  console.log('currently records which capabilities each vertical actually uses -- that');
+  console.log('link has to be built (or the two systems merged) before a real matrix can');
+  console.log('be rendered without fabricating cells.');
+
+  return report;
+}
+
+if (require.main === module) {
+  main();
+}
+
+module.exports = { main, parseRoutes, dedupeByUrl };
-- 
