From 5c85f767e210a5d22224b828dd4a43d8dfc95752 Mon Sep 17 00:00:00 2001
From: Tron <tron@tsmconsultz.com>
Date: Wed, 5 Aug 2026 02:50:37 +0000
Subject: [PATCH 2/6] feat(finops): add Business Impact Delta to strategist
 page
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Adds the No-Action / With-Action exposure projection box using the
shared TSMBNCAExposureEngine (same deterministic engine already used
by Insurance, Real Estate, Healthcare, BPO) — no LLM-guessed dollars.

Inputs: exposure range and risk score already parsed from the live
Groq strategist output (_expM/_riskM), severity banded from risk score
following the same thresholds insurance uses. No deadline signal is
parsed for this vertical yet, so daysUntilDeadline defaults to 0
(matches Insurance's documented limitation).

Delta box resets to '—' at the start of each report run and shows
'N/A' with a stated reason on failure, per the platform's honesty
pattern — never a stale or fabricated number.
---
 .../finops-war/finops-main-strategist.html    | 50 +++++++++++++++++++
 1 file changed, 50 insertions(+)

diff --git a/html/finops-suite/finops-war/finops-main-strategist.html b/html/finops-suite/finops-war/finops-main-strategist.html
index 6804bee4..37a1d9b6 100644
--- a/html/finops-suite/finops-war/finops-main-strategist.html
+++ b/html/finops-suite/finops-war/finops-main-strategist.html
@@ -177,6 +177,17 @@ body{background:var(--bg);color:var(--text);font-family:var(--font);font-size:13
 .risk-val.ok{color:var(--green-bright)}
 .risk-val.info{color:var(--accent)}
 
+/* ====== BUSINESS IMPACT DELTA ====== */
+.tsm-delta-row{display:flex;gap:8px;margin-top:4px}
+.tsm-delta-box{flex:1;padding:8px;border-radius:3px;text-align:center;border:1px solid var(--border)}
+.tsm-delta-no{background:rgba(255,68,85,.06);border-color:rgba(255,68,85,.18)}
+.tsm-delta-act{background:rgba(0,229,100,.06);border-color:rgba(0,229,100,.18)}
+.tsm-delta-lbl{font-size:9px;letter-spacing:.06em;margin-bottom:3px;opacity:.55;text-transform:uppercase}
+.tsm-delta-val{font-family:'Orbitron',sans-serif;font-size:13px}
+.tsm-delta-no .tsm-delta-val{color:var(--red)}
+.tsm-delta-act .tsm-delta-val{color:var(--green-bright)}
+.tsm-recovery{text-align:center;font-size:9px;margin-top:5px;opacity:.45}
+
 /* ====== OUTPUT AREA ====== */
 .output-box{border:1px solid var(--border);background:var(--bg);margin-bottom:16px;position:relative}
 .output-header{display:flex;align-items:center;justify-content:space-between;padding:9px 14px;border-bottom:1px solid var(--border);background:var(--bg-card)}
@@ -375,6 +386,7 @@ body{background:var(--bg);color:var(--text);font-family:var(--font);font-size:13
   <script src="/html/war-rooms/_relay_control_plane/relay.core.js"></script>
   <script src="/html/shared/runtime/mission/mission-model.js"></script>
   <script src="/html/shared/runtime/mission/mission-store.js"></script>
+  <script src="/html/js/tsm-bnca-exposure-engine.js"></script>
   <script src="/js/core/tsm-mission-engine.js"></script>
   <script src="/js/core/tsm-auto-pipeline.js"></script>
 </head>
@@ -566,6 +578,15 @@ body{background:var(--bg);color:var(--text);font-family:var(--font);font-size:13
       </div>
     </div>
 
+    <div style="margin-top:14px">
+      <div class="section-label">Business Impact Delta</div>
+      <div class="tsm-delta-row">
+        <div class="tsm-delta-box tsm-delta-no"><div class="tsm-delta-lbl">No Action</div><div class="tsm-delta-val" id="finXPDeltaNo">—</div></div>
+        <div class="tsm-delta-box tsm-delta-act"><div class="tsm-delta-lbl">With Action</div><div class="tsm-delta-val" id="finXPDeltaAct">—</div></div>
+      </div>
+      <div class="tsm-recovery" id="finXPRecovery">Run the strategist report to project exposure impact.</div>
+    </div>
+
   </div>
 
   <!-- MAIN OUTPUT -->
@@ -1067,6 +1088,8 @@ async function generateReport(){
   document.getElementById('modelUsed').textContent = document.getElementById('modelSel').value;
   out.textContent = '';
   out.classList.add('loading');
+  { const dNo = document.getElementById('finXPDeltaNo'), dAct = document.getElementById('finXPDeltaAct'), dRec = document.getElementById('finXPRecovery');
+    if (dNo) dNo.textContent = '—'; if (dAct) dAct.textContent = '—'; if (dRec) dRec.textContent = 'Projecting from live analysis...'; }
   out.innerHTML = '<div class="spinner"></div> Generating report via Groq...';
 
   try{
@@ -1089,6 +1112,31 @@ async function generateReport(){
     const _poM = _txt.match(/Missing PO[^:\n]*[:\s]+(\$[\d,]+)/i);
     const _excM = _txt.match(/(?:EXCEPTION COUNT|CRITICAL ITEMS)[:\s]+(\d+)/i);
     const _compM = _txt.match(/(?:COMPLIANCE|PERIOD)[:\s]+([^\n]+)/i);
+    // Business Impact Delta — deterministic, no LLM-guessed dollars.
+    // Uses the same shared engine as Insurance/RE/Healthcare/BPO so the
+    // math is identical across verticals; only the inputs differ.
+    try {
+      if (window.TSMBNCAExposureEngine) {
+        const finExpStr = _expM ? _expM[1] : null;
+        const finExpNums = finExpStr ? finExpStr.match(/[\d,]+/g) : null;
+        const finBaseExposure = finExpNums ? parseInt(finExpNums[0].replace(/,/g, ''), 10) : 0;
+        const finRiskNum = _riskM ? parseInt(_riskM[1], 10) : null;
+        const finSeverity = finRiskNum === null ? 'MED' : (finRiskNum >= 80 ? 'CRIT' : finRiskNum >= 60 ? 'HIGH' : finRiskNum >= 35 ? 'MED' : 'LOW');
+        const finImpact = window.TSMBNCAExposureEngine.project({
+          baseExposure: finBaseExposure,
+          severity: finSeverity,
+          confidence: finRiskNum !== null ? finRiskNum : 70,
+          daysUntilDeadline: 0 // no independent deadline signal parsed for this vertical yet
+        });
+        const finFmt = n => '$' + Math.round(n).toLocaleString('en-US');
+        const finDeltaNoEl = document.getElementById('finXPDeltaNo');
+        const finDeltaActEl = document.getElementById('finXPDeltaAct');
+        const finRecoveryEl = document.getElementById('finXPRecovery');
+        if (finDeltaNoEl) finDeltaNoEl.textContent = finFmt(finImpact.ifIgnored.exposure);
+        if (finDeltaActEl) finDeltaActEl.textContent = finFmt(finImpact.ifActed.exposure);
+        if (finRecoveryEl) finRecoveryEl.textContent = finImpact.urgencyWindow + ' · ' + finImpact.methodology;
+      }
+    } catch (finDeltaErr) { console.warn('[bnca-exposure-engine] finops render error:', finDeltaErr); }
     sessionStorage.setItem('tsm_strategist_relay', JSON.stringify({
       wip: (window.TSMExecKitProducer && TSMExecKitProducer.buildWip([
         { id:'ingest',    label:'Document Ingestion', status:'done' },
@@ -1150,6 +1198,8 @@ async function generateReport(){
     out.classList.remove('loading');
     out.textContent = '[ERROR] '+e.message+'\n\nCheck your Groq API key and try again.';
     document.getElementById('runStatus').textContent = 'ERROR';
+    { const dNo = document.getElementById('finXPDeltaNo'), dAct = document.getElementById('finXPDeltaAct'), dRec = document.getElementById('finXPRecovery');
+      if (dNo) dNo.textContent = 'N/A'; if (dAct) dAct.textContent = 'N/A'; if (dRec) dRec.textContent = 'Unavailable — analysis did not complete.'; }
   }
   btn.disabled = false;
 }
