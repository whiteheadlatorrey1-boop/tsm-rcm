# ── QuickBooks Online (ERP) integration ─────────────────────────────────
# From an Intuit Developer account: https://developer.intuit.com
# Create an app there, then pull these from its Keys & OAuth page.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Must exactly match a Redirect URI registered on the Intuit app, e.g.:
#   http://localhost:3000/api/integrations/quickbooks/callback
QBO_REDIRECT_URI=
# 'sandbox' until this integration has been reviewed for production use —
# sandbox points at Intuit's fake company data, so there's no real
# financial data at risk while this is being built/tested.
QBO_ENVIRONMENT=sandbox

# ── Gmail integration (read-only) ───────────────────────────────────────
# From a Google Cloud project: https://console.cloud.google.com
# Enable the Gmail API, create an OAuth 2.0 Client ID (Web application),
# then pull these from its credentials page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI on the OAuth client, e.g.:
#   http://localhost:3000/api/integrations/gmail/callback
GOOGLE_REDIRECT_URI=
# Optional — Gmail search syntax. Defaults to 'is:unread newer_than:30d'.
GMAIL_QUERY=
