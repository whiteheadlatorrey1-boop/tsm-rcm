# ── QuickBooks Online (ERP) integration ─────────────────────────────────
# From an Intuit Developer account: https://developer.intuit.com
# Create an app there, then pull these from its Keys & OAuth page.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Must exactly match a Redirect URI registered on the Intuit app, e.g.:
#   http://localhost:3000/api/integrations/quickbooks/callback
QBO_REDIRECT_URI=
# 'sandbox' until this integration has been reviewed for production use —
# sandbox points at Intuit's fake company data, so there's no real
# financial data at risk while this is being built/tested.
QBO_ENVIRONMENT=sandbox
