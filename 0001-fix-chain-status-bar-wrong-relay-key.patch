+++ b/html/war-rooms/bpo-war/bpo-war-room.html
@@ -249,7 +249,7 @@ body::before{content:'';position:fixed;inset:0;background:repeating-linear-gradi
 </div>
 <script>
 (function(){
-  const RELAY_KEY = 'TSM_RELAY_PAYLOAD';
+  const RELAY_KEY = 'TSM_BPO_WAR_RELAY'; // real key written by storeWarRoomRelay()
   const strat  = document.getElementById('tsm-chain-strat');
   const exec   = document.getElementById('tsm-chain-exec');
   const status = document.getElementById('tsm-chain-status');
@@ -266,7 +266,8 @@ body::before{content:'';position:fixed;inset:0;background:repeating-linear-gradi
       const raw = localStorage.getItem(RELAY_KEY);
       if (!raw) { status.textContent = 'War room active — no relay yet'; return; }
       const d = JSON.parse(raw);
-      const age = Date.now() - (d.timestamp || 0);
+      const relayTs = typeof d.timestamp === 'string' ? new Date(d.timestamp).getTime() : (d.timestamp || 0);
+      const age = Date.now() - relayTs;
       const fresh = age < 5 * 60 * 1000; // 5 min
 
       if (fresh) {
