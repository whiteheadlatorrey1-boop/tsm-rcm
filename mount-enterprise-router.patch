From 42fe9796f6faca5a838302a53c1bd3622f5e36d8 Mon Sep 17 00:00:00 2001
From: Tron <tron@tsm-consultz.local>
Date: Sat, 25 Jul 2026 15:49:34 +0000
Subject: [PATCH] Mount server/enterprise/api/enterprise-router.js at
 /api/enterprise

The Enterprise Enrichment Engine (server/enterprise/) was fully built and
unit-tested (scripts/test-enterprise-engine.js, test-bnca.js,
test-explainability.js, test-enterprise-orchestrator.js, test-sprint3.js)
but its Express router was never mounted in server.js.

POST /api/enterprise/enrich was 404ing in production despite
html/war-rooms/mortgage/services/mortgage-engine.js and
html/war-rooms/schools/services/schools-engine.js both already fetch()ing
it directly, believing (per their own comments) that other verticals
already used it live.

Verified locally: server boots clean, all 10 capability modules
(o2c/crm/cpq/catalog/approval/mdm/integration/governance/wip/digital-twin)
load, and /health, /enrich, /dashboard all return real structured data
instead of 404.
---
 server.js | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/server.js b/server.js
index 8711e6a1..e5f4e4b0 100644
--- a/server.js
+++ b/server.js
@@ -883,6 +883,16 @@ app.use(require('./routes/music'));
 // chain — see routes/enterprise-capability-bridge.js header for full design.
 app.use(require('./routes/enterprise-capability-bridge'));
 
+// ── ENTERPRISE ENRICHMENT ENGINE ────────────────────────────────────────────────
+// server/enterprise/api/enterprise-router.js (POST /enrich, /dashboard,
+// /decision, /missions, GET /health) was fully built and unit-tested
+// (scripts/test-enterprise-engine.js etc.) but never mounted here, so
+// POST /api/enterprise/enrich 404'd in production despite
+// html/war-rooms/mortgage/services/mortgage-engine.js and
+// html/war-rooms/schools/services/schools-engine.js both already calling
+// it directly. This is the missing mount.
+app.use('/api/enterprise', require('./server/enterprise/api/enterprise-router'));
+
 
 // ── FINOPS ────────────────────────────────────────────────────────────────────
 app.post('/api/finops/bnca/report', (req, res) => res.json({ ok: true }));
