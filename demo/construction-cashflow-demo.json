{
  "vertical": "construction",
  "note": "Cash Flow / Reconciliation Gap variant — same flow as construction-demo.json but loads the #smp-cashflow chip (loadSample('cashflow')) instead of the built-in #smp-demo anomaly. Source-verified against whiteheadlatorrey1-boop/tsm-rcm (html/war-rooms/construct-war/construction-war-room.html) by reading real ids/onclick handlers directly -- NOT live-verified via Playwright (this sandbox hits the same chrome-headless-shell 403 as the Codespace). escalateToExecutive() in construction-strategist.html hard-blocks with an alert() unless #bncaOutput has 50+ chars, so the BNCA synthesis run must complete first. Run once in Codespaces and correct any selector drift before treating as final.",
  "steps": [
    {
      "shot": "001-war-room-load",
      "goto": "/html/war-rooms/construct-war/construction-war-room.html",
      "waitMs": 1500
    },
    {
      "shot": "002-load-cashflow-sample",
      "click": "#smp-cashflow",
      "waitFor": "#con-upload-name",
      "waitMs": 800
    },
    {
      "shot": "003-fire-engines",
      "click": "#fireBtn",
      "waitFor": "#kpiEngines",
      "waitMs": 5000
    },
    {
      "shot": "004-engines-complete",
      "waitFor": "#escalateBar",
      "waitMs": 800
    },
    {
      "shot": "004b-disable-auto-mode",
      "setLocalStorage": {
        "tsm_auto_mode": "off"
      },
      "waitMs": 100
    },
    {
      "shot": "005-escalate-to-strategist",
      "click": "button[onclick=\"escalateToStrategist()\"]",
      "waitMs": 2000
    },
    {
      "shot": "006-strategist-load",
      "waitMs": 800
    },
    {
      "shot": "006b-open-expansion-tab",
      "click": "#nl-expansion",
      "waitFor": "#vp-expansion.active",
      "waitMs": 500
    },
    {
      "shot": "007-run-bnca-synthesis",
      "click": "#synthAllBtn",
      "waitForFunction": "document.getElementById('bncaOutput')?.textContent.length > 50",
      "timeout": 45000,
      "waitMs": 800
    },
    {
      "shot": "008-explainability",
      "waitFor": "#conXPReasoning",
      "waitMs": 600
    },
    {
      "shot": "009-escalate-to-exec",
      "click": "button[onclick=\"escalateToExecutive()\"]",
      "waitMs": 2000
    },
    {
      "shot": "010-exec-portal-kpis",
      "waitFor": "#kpiExposure",
      "waitMs": 800
    },
    {
      "shot": "011-exec-explainability",
      "waitFor": ".tsmk-explain",
      "waitMs": 600
    }
  ]
}
