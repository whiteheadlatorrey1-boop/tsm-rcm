From a57cf65e9bcd20964f3af8d244a50083afbd17bf Mon Sep 17 00:00:00 2001
From: Latorrey Whitehead <latorreyw99@gmail.com>
Date: Tue, 4 Aug 2026 14:05:27 +0000
Subject: [PATCH] fix(construction-strategist): repair broken data-tsm-args
 chaining on 3 pushMod buttons

The Zero Trust/Tax Prep/Legal 'Push to Strategist BNCA' buttons had
malformed data-tsm-args ('key');navTo('expansion') left over from a
chained onclick="pushMod();navTo()" conversion. The single-action
delegate pattern evals the args as one array literal, so this threw
a syntax error that was silently caught -- the buttons did nothing:
no module push, no navigation to the Expansion tab, leaving
#synthAllBtn unreachable via that path.

Added pushModAndExpand(key) wrapper (pushMod + navTo in one real
function) and pointed all 3 buttons at it via a single valid
data-tsm-args string. Plain Expansion nav link was already wired
correctly and unaffected.

Verified: all 4 inline <script> blocks in the file still pass
node --check.
---
 .../construct-war/construction-strategist.html   | 16 +++++++++++++---
 1 file changed, 13 insertions(+), 3 deletions(-)

diff --git a/html/war-rooms/construct-war/construction-strategist.html b/html/war-rooms/construct-war/construction-strategist.html
index e1aed9c..51be60f 100644
--- a/html/war-rooms/construct-war/construction-strategist.html
+++ b/html/war-rooms/construct-war/construction-strategist.html
@@ -394,7 +394,7 @@ body{font-family:var(--mono);background:var(--bg);color:var(--text);font-size:12
       <div class="dt-row" style="grid-template-columns:1fr 1fr 80px 90px"><span class="dt-name">Vendor Portal</span><span>BuildCo Ext.</span><span><div class="pill p-med">MEDIUM</div></span><span><button class="act-btn" data-tsm-action="ztDone" data-tsm-args="this">Review</button></span></div>
     </div>
   </div>
-  <button class="big-synth" style="background:var(--rose);color:#0a0e09" data-tsm-action="pushMod" data-tsm-args="'zerotrust');navTo('expansion'">→ Push Zero Trust to Strategist BNCA</button>
+  <button class="big-synth" style="background:var(--rose);color:#0a0e09" data-tsm-action="pushModAndExpand" data-tsm-args="'zerotrust'">→ Push Zero Trust to Strategist BNCA</button>
 </div>
 
 <!-- VIEW: TAX PREP -->
@@ -420,7 +420,7 @@ body{font-family:var(--mono);background:var(--bg);color:var(--text);font-size:12
     <div class="tax-row"><div><div class="tx-name">Home / Site Office</div><div class="tx-sub">Qualifying sq footage documented</div></div><div class="tx-acts"><span class="pill p-pend">$4,800</span></div></div>
     <div class="tax-row"><div><div class="tx-name">Professional Development</div><div class="tx-sub">Certifications + training expenses</div></div><div class="tx-acts"><span class="pill p-pend">$1,486</span></div></div>
   </div>
-  <button class="big-synth" style="background:var(--yellow);color:#0a0e09" data-tsm-action="pushMod" data-tsm-args="'taxprep');navTo('expansion'">→ Push Tax Prep to Strategist BNCA</button>
+  <button class="big-synth" style="background:var(--yellow);color:#0a0e09" data-tsm-action="pushModAndExpand" data-tsm-args="'taxprep'">→ Push Tax Prep to Strategist BNCA</button>
 </div>
 
 <!-- VIEW: LEGAL -->
@@ -451,7 +451,7 @@ body{font-family:var(--mono);background:var(--bg);color:var(--text);font-size:12
     <div class="tax-row"><div><div class="tx-name">PacSteel Inc. — Delivery #3</div><div class="tx-sub">$18,200 · Unconditional waiver due</div></div><div class="tx-acts"><span class="pill p-pend">Pending</span></div></div>
     <div class="tax-row"><div><div class="tx-name">Ironworks — PO-114</div><div class="tx-sub">$9,800 · First lien filing</div></div><div class="tx-acts"><span class="pill p-thr">Due May 20</span></div></div>
   </div>
-  <button class="big-synth" style="background:var(--purple);color:#0a0e09" data-tsm-action="pushMod" data-tsm-args="'legal');navTo('expansion'">→ Push Legal to Strategist BNCA</button>
+  <button class="big-synth" style="background:var(--purple);color:#0a0e09" data-tsm-action="pushModAndExpand" data-tsm-args="'legal'">→ Push Legal to Strategist BNCA</button>
 </div>
 
 <!-- ═══════════════════════════════════
@@ -650,6 +650,16 @@ function pushMod(key) {
   updateExpBadge();
 }
 
+// Wrapper for buttons that need to push a module AND jump to the Expansion
+// view in one click. The data-tsm-action delegate only supports a single
+// action name + one eval'd args list, so this can't be done by chaining
+// two calls in data-tsm-args (that produced a silently-swallowed eval
+// syntax error — see fix note above the 3 callers below).
+function pushModAndExpand(key) {
+  pushMod(key);
+  navTo('expansion');
+}
+
 function updateExpBadge() {
   const badge = document.getElementById('exp-badge');
   if (pushed.size > 0) { badge.style.display = 'inline'; badge.textContent = pushed.size; }
-- 
