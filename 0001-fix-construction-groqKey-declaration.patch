From d2483db32756101ff76381b7d054554c02241989 Mon Sep 17 00:00:00 2001
From: whiteheadlatorrey1-boop <whiteheadlatorrey1@gmail.com>
Date: Tue, 4 Aug 2026 13:29:13 +0000
Subject: [PATCH] fix: declare missing groqKey in construction war room

construction-war-room.html referenced/wrote groqKey (init, saveKey,
testKey) but never declared it, unlike insurance-war-room.html and
finops-war-room.html which both have:
  let groqKey = localStorage.getItem('tsm_groq_key') || '';

The resulting ReferenceError at script load aborted the rest of the
527-1577 inline <script> block before it reached 'const SAMPLES = {...}',
leaving SAMPLES stuck in its TDZ. loadDemoAnomaly (a hoisted function
declaration) was still callable via onclick, so clicking the demo
button threw a second, seemingly-unrelated 'Cannot access SAMPLES
before initialization' error.

Root cause was singular: adding the missing declaration (mirroring
the existing insurance/finops pattern) resolves both pageErrors.

Verified via node --check on extracted script + a minimal DOM-stub
harness reproducing the before/after crash behavior (Playwright
browser binaries not reachable in this sandboxed network, so full
e2e trace re-capture should be re-run in Codespaces to close the loop).
---
 html/war-rooms/construct-war/construction-war-room.html | 1 +
 1 file changed, 1 insertion(+)

diff --git a/html/war-rooms/construct-war/construction-war-room.html b/html/war-rooms/construct-war/construction-war-room.html
index 024df7b5..c127b068 100644
--- a/html/war-rooms/construct-war/construction-war-room.html
+++ b/html/war-rooms/construct-war/construction-war-room.html
@@ -588,6 +588,7 @@ let docText='', selectedDocType='Change Order', engOut={}, enginesComplete=0;
     if (ta) ta.value = relayText;
   } catch(e) { console.warn('Doc search relay error:', e); }
 })();
+let groqKey = localStorage.getItem('tsm_groq_key') || '';
 if(groqKey){ const gkInit=document.getElementById('groqKey'); if(gkInit) gkInit.value=groqKey; }
 
 setInterval(()=>{ document.getElementById('navClock').textContent=new Date().toLocaleTimeString('en-US',{hour12:false}); },1000);
-- 
