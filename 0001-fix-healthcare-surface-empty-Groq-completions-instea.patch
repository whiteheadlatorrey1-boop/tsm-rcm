From fb9ae4bce9cceea09db838a5d9646b6e48f21e97 Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic-session.local>
Date: Sun, 2 Aug 2026 07:06:10 +0000
Subject: [PATCH] fix(healthcare): surface empty Groq completions instead of
 silently swallowing them
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- server.js groqChat(): a 200 OK response with empty/whitespace-only
  content was returned as if it were a valid answer. Now treated as a
  failure and retried against the next model in GROQ_MODELS, same as
  a rate-limit or 5xx.
- hc-main-strategist.html: both callClaude() and callClaudeWithExplain()
  had an if(data.output)/else if(data.error) chain that silently did
  nothing when output was '' (falsy) and no error was set — status
  just flipped back to READY with no feedback. Added an else branch
  that throws a real 'AI returned an empty response' error so it hits
  the existing error UI.
---
 html/healthcare/hc-main-strategist.html |  4 ++++
 server.js                               | 12 ++++++++++--
 2 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/html/healthcare/hc-main-strategist.html b/html/healthcare/hc-main-strategist.html
index 5d0db15..710c8d9 100644
--- a/html/healthcare/hc-main-strategist.html
+++ b/html/healthcare/hc-main-strategist.html
@@ -863,6 +863,8 @@ async function callClaude(userMsg, outEl, thinkEl, errEl){
       outEl.classList.add('show','fi');
     } else if(data.error){
       throw new Error(data.error);
+    } else {
+      throw new Error('AI returned an empty response. Try again.');
     }
     document.getElementById('sb-status').textContent='READY';
   } catch(e){
@@ -1062,6 +1064,8 @@ async function callClaudeWithExplain(userMsg, outEl, thinkEl, errEl){
       }
     } else if(data.error){
       throw new Error(data.error);
+    } else {
+      throw new Error('AI returned an empty response. Try again.');
     }
     document.getElementById('sb-status').textContent='READY';
   } catch(e){
diff --git a/server.js b/server.js
index 083e6f2..e240b95 100644
--- a/server.js
+++ b/server.js
@@ -105,7 +105,15 @@ async function groqChat(system, message, maxTokens, clientKey, jsonMode) {
           throw new Error('Groq API error ' + r.status + ': ' + err);
         }
         const data = await r.json();
-        return data?.choices?.[0]?.message?.content || '';
+        const content = data?.choices?.[0]?.message?.content || '';
+        if (!content.trim()) {
+          // 200 OK but empty content (e.g. filtered/refused/stopped immediately) —
+          // treat as a failure and try the next model rather than silently
+          // returning "" to the caller.
+          console.warn('[groqChat] empty completion from', model, '- finish_reason:', data?.choices?.[0]?.finish_reason);
+          continue;
+        }
+        return content;
       } catch (e) {
         if (e.message.includes('429') || e.message.includes('rate_limit')) continue;
         if (useJsonMode) continue; // try the same model again without json mode before moving on
@@ -113,7 +121,7 @@ async function groqChat(system, message, maxTokens, clientKey, jsonMode) {
       }
     }
   }
-  throw new Error('All Groq models rate limited. Try again later.');
+  throw new Error('All Groq models returned empty or rate-limited responses. Try again later.');
 }
 
 // JSON-returning variant for structured routes
-- 
