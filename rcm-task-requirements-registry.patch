 function taskKey(cad, p, t){ return `${cad}-${p}-${t}`; }
 
+// ─────────────────────────────────────────────────────────────────────────
+// TASK DATA REQUIREMENTS REGISTRY — what an EU needs to gather from each
+// phase's owning module, and their self-reported values until that module
+// exposes a real read endpoint. See routes/rcm-requirements.js.
+// Everything here is explicitly source: 'self-reported' — never presented
+// as verified/computed. That honesty is the whole point of this layer.
+// ─────────────────────────────────────────────────────────────────────────
+let REQUIREMENTS = {};   // { "daily-2": { phaseName, tool, requiredFields:[{id,field,type,why}] } }
+let selfReported = {};   // { "daily-2": { openFlagCount: {value, reportedAt, source} } }
+
+async function loadRequirements(){
+  try {
+    const [reqRes, srRes] = await Promise.all([
+      fetch('/api/rcm/requirements'),
+      fetch('/api/rcm/self-reported')
+    ]);
+    const reqData = await reqRes.json();
+    const srData = await srRes.json();
+    REQUIREMENTS = reqData.phases || {};
+    selfReported = srData.data || {};
+  } catch(e) {
+    REQUIREMENTS = {};
+    selfReported = {};
+  }
+  // Re-render whatever's currently on screen so the new data shows up.
+  if(currentCadence === 'executive') renderExecutive();
+  else renderCadenceBody();
+}
+
+function reqSummaryCount(){
+  let filled = 0, expected = 0;
+  Object.keys(REQUIREMENTS).forEach(key=>{
+    const fields = REQUIREMENTS[key].requiredFields || [];
+    expected += fields.length;
+    fields.forEach(f=>{ if(selfReported[key] && selfReported[key][f.id]) filled++; });
+  });
+  return { filled, expected };
+}
+
+function renderReqBlock(cadence, phaseIdx){
+  const key = `${cadence}-${phaseIdx}`;
+  const spec = REQUIREMENTS[key];
+  if(!spec || !spec.requiredFields || !spec.requiredFields.length) return '';
+  const filledForPhase = spec.requiredFields.filter(f=>selfReported[key] && selfReported[key][f.id]).length;
+
+  return `
+  <div class="req-block" data-req-key="${key}">
+    <div class="req-head">
+      <span class="req-label">Data to gather from ${escapeHtml(spec.tool)}</span>
+      <span class="req-label">${filledForPhase}/${spec.requiredFields.length} self-reported</span>
+    </div>
+    ${spec.requiredFields.map(f=>{
+      const entry = selfReported[key] && selfReported[key][f.id];
+      const badge = entry
+        ? `<span class="req-badge" title="Self-reported, not verified">✎ self-reported · ${new Date(entry.reportedAt).toLocaleDateString()}</span>`
+        : `<span class="req-badge empty">not yet gathered</span>`;
+      return `
+      <div class="req-field" data-field-id="${escapeHtml(f.id)}">
+        <div class="req-field-top">
+          <span class="req-field-name">${escapeHtml(f.field)}</span>
+          ${badge}
+        </div>
+        <div class="req-why">${escapeHtml(f.why)}</div>
+        <div class="req-row">
+          <input class="req-input" type="text" placeholder="Enter value from ${escapeHtml(spec.tool)}..." value="${escapeHtml(entry ? entry.value : '')}">
+          <button class="req-save">Save</button>
+        </div>
+      </div>`;
+    }).join('')}
+  </div>`;
+}
+
+function wireReqBlocks(container){
+  container.querySelectorAll('.req-block').forEach(block=>{
+    const key = block.dataset.reqKey;
+    block.querySelectorAll('.req-field').forEach(fieldEl=>{
+      const fieldId = fieldEl.dataset.fieldId;
+      const input = fieldEl.querySelector('.req-input');
+      const btn = fieldEl.querySelector('.req-save');
+      const submit = () => saveSelfReport(key, fieldId, input.value);
+      btn.addEventListener('click', submit);
+      input.addEventListener('keydown', (e)=>{ if(e.key === 'Enter') submit(); });
+    });
+  });
+}
+
+async function saveSelfReport(key, fieldId, value){
+  if(!value || !value.trim()) return;
+  try {
+    const res = await fetch('/api/rcm/self-reported', {
+      method: 'POST', headers: {'Content-Type':'application/json'},
+      body: JSON.stringify({ key, fieldId, value: value.trim() })
+    });
+    const data = await res.json();
+    if(data.ok){
+      if(!selfReported[key]) selfReported[key] = {};
+      selfReported[key][fieldId] = data.entry;
+      renderCadenceBody();
+      if(currentCadence === 'executive') renderExecutive();
+      fetchGuidance();
+    }
+  } catch(e) { /* silent — form just won't show as saved */ }
+}
