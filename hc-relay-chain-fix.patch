From 3d952dd5e68b4552bdaa7f1c44527292cbe7ec45 Mon Sep 17 00:00:00 2001
From: Tron <tron@tsm-consultz.local>
Date: Sat, 25 Jul 2026 20:48:28 +0000
Subject: [PATCH] Fix healthcare relay chain: war-room doc-search
 intake/escalate + sentinel exec-portal path

Three root-caused bugs in the doc-search -> war-room -> hc-main-strategist ->
sentinel-center/exec-portal chain, fixed (not patched around):

1. hc-denial-war-room.html never read tsm-doc-search-multi.html's payload
   (tsm_hc_docsearch_relay / TSM_HC_WAR_RELAY). Fixed: added an intake
   banner that reads it and displays the routed case.

2. hc-denial-war-room.html had NO outbound navigation/escalation to
   hc-main-strategist.html at all, despite including relay.engine.js --
   buildWarRoomBrief() expects #doc-text/#out1-5 elements this denial-queue
   page doesn't have, so it was never wired up. Fixed: added
   escalateHcDenialToStrategist(), a page-specific escalate function that
   builds a real TSM_WAR_ROOM_BRIEF payload and navigates to
   hc-main-strategist.html.

3. sentinel-center.html's EXEC_PORTAL_PATHS.healthcare pointed at
   /html/war-rooms/healthcare/executive-portal.html, a directory that
   doesn't exist (confirmed). Fixed to point at the real file,
   /html/healthcare/executive-portal.html.

Verified: node --check on the extracted inserted script block passes;
confirmed the pre-existing <script> tag count imbalance in
hc-denial-war-room.html (14 open / 17 close) predates this change and is
unaffected by it (now 15/18, exactly +1/+1).
---
 html/healthcare/hc-denial-war-room.html | 77 +++++++++++++++++++++++++
 html/sentinel-center.html               |  2 +-
 2 files changed, 78 insertions(+), 1 deletion(-)

diff --git a/html/healthcare/hc-denial-war-room.html b/html/healthcare/hc-denial-war-room.html
index b9ee4a77..e9a4cdf1 100644
--- a/html/healthcare/hc-denial-war-room.html
+++ b/html/healthcare/hc-denial-war-room.html
@@ -2893,6 +2893,83 @@ setInterval(buildStratBriefTab, 30000);
 <script src="/html/healthcare/js/relay.engine.js"></script>
 <script src="/html/healthcare/js/memory.engine.js"></script>
 <script src="/html/healthcare/js/relay-card.component.js"></script>
+
+<script id="tsm-docsearch-intake-and-escalate">
+// ── DOC-SEARCH INTAKE + ESCALATE-TO-STRATEGIST ─────────────────────────────
+// hc-denial-war-room.html previously had no reader for the payload
+// tsm-doc-search-multi.html actually writes (tsm_hc_docsearch_relay /
+// TSM_HC_WAR_RELAY), and no way to hand a case off to hc-main-strategist.html
+// at all -- relay.engine.js was included but never called (buildWarRoomBrief()
+// expects #doc-text/#out1-5 elements that don't exist on this denial-queue
+// page, so it was never a fit as-is). This block is additive: it doesn't
+// touch the existing denial-queue rendering, it just adds the missing
+// intake + outbound hop using relay.engine.js's own relayToStrategist(),
+// with a payload shape built for THIS page's actual data instead of the
+// generic one.
+(function () {
+  const DOC_SEARCH_KEYS = ['tsm_hc_docsearch_relay', 'TSM_HC_WAR_RELAY'];
+
+  function readDocSearchPayload() {
+    for (const key of DOC_SEARCH_KEYS) {
+      try {
+        const raw = localStorage.getItem(key) || sessionStorage.getItem(key);
+        if (!raw) continue;
+        const parsed = JSON.parse(raw);
+        // doc-search's payload timestamp is Date.now() (a number, ms).
+        if (parsed && parsed.timestamp && (Date.now() - Number(parsed.timestamp)) < 7200000) {
+          return parsed;
+        }
+      } catch (e) { /* not JSON or not present -- skip */ }
+    }
+    return null;
+  }
+
+  function renderIntakeBanner(doc) {
+    const bar = document.createElement('div');
+    bar.id = 'docsearch-intake-banner';
+    bar.style.cssText = 'margin:16px 24px;padding:10px 16px;background:rgba(56,189,248,0.08);' +
+      'border:1px solid rgba(56,189,248,0.3);border-radius:4px;font-family:"JetBrains Mono",monospace;' +
+      'font-size:9px;color:#7dd3fc;display:flex;align-items:center;justify-content:space-between;gap:12px;';
+    const label = document.createElement('span');
+    label.textContent = '◈ ROUTED FROM DOC SEARCH · ' + (doc.fileName || doc.docType || 'document') +
+      (doc.client ? ' · ' + doc.client : '');
+    const btn = document.createElement('button');
+    btn.textContent = '→ ESCALATE TO STRATEGIST';
+    btn.style.cssText = 'background:#0891b2;color:#fff;border:none;padding:6px 12px;border-radius:3px;' +
+      'font-family:inherit;font-size:9px;font-weight:700;letter-spacing:1px;cursor:pointer;white-space:nowrap;';
+    btn.onclick = function () { escalateHcDenialToStrategist(doc); };
+    bar.appendChild(label);
+    bar.appendChild(btn);
+    const anchor = document.body.firstElementChild;
+    document.body.insertBefore(bar, anchor);
+  }
+
+  window.escalateHcDenialToStrategist = function (docOverride) {
+    const doc = docOverride || readDocSearchPayload() || {};
+    const payload = {
+      source: 'hc-denial-war-room',
+      vertical: 'Healthcare',
+      sessionId: sessionStorage.getItem('tsm_session_id') || ('hc_' + Date.now()),
+      docText: (doc.docText || '').substring(0, 2000),
+      docType: doc.docType || '',
+      fileName: doc.fileName || '',
+      client: doc.client || '',
+      ref: doc.ref || '',
+      timestamp: Date.now(),
+    };
+    try {
+      sessionStorage.setItem('TSM_WAR_ROOM_BRIEF', JSON.stringify(payload));
+      localStorage.setItem('TSM_WAR_ROOM_BRIEF', JSON.stringify(payload));
+    } catch (e) { console.error('[hc-denial-war-room] failed to write TSM_WAR_ROOM_BRIEF:', e); }
+    window.location.href = '/html/healthcare/hc-main-strategist.html';
+  };
+
+  document.addEventListener('DOMContentLoaded', function () {
+    const doc = readDocSearchPayload();
+    if (doc) renderIntakeBanner(doc);
+  });
+})();
+</script>
   <!-- tsm-kernel-upgrade.js stubbed (file pending) -->
 <script src="/js/core/tsm-event-bus.js"></script>
 <script src="/shared/tsm-exec-portal-upgrade.js"></script>
diff --git a/html/sentinel-center.html b/html/sentinel-center.html
index d34f080b..f9e6ea7b 100644
--- a/html/sentinel-center.html
+++ b/html/sentinel-center.html
@@ -542,7 +542,7 @@ const EXEC_PORTAL_PATHS = {
   insurance:    '/html/war-rooms/insurance/insurance-executive-portal.html',
   bpo:          '/html/war-rooms/bpo/bpo-executive-portal.html',
   realestate:   '/html/war-rooms/real_estate/re-exec-portal.html',
-  healthcare:   '/html/war-rooms/healthcare/executive-portal.html',
+  healthcare:   '/html/healthcare/executive-portal.html', // [FIXED] was /html/war-rooms/healthcare/... (404, dir doesn't exist)
   finops:       '/html/war-rooms/finops/finops-executive-portal.html',
 };
 
