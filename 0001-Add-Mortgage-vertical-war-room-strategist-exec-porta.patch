+      { "condition_id": "COND-JM-01",  "loan_id": "JUMBO-010",   "description": "Gift fund sourcing letter",           "stage": "issued",       "entered_stage_at_hours_ago": 20, "notes": "Not yet received from borrower." },
+      { "condition_id": "COND-DS-01",  "loan_id": "DSCR-011",    "description": "Revised lease agreement",             "stage": "issued",       "entered_stage_at_hours_ago": 48, "notes": "Stalled — borrower unresponsive 2 days." },
+      { "condition_id": "COND-DK-01",  "loan_id": "DK-022",      "description": "Title lien payoff confirmation",      "stage": "under_review", "entered_stage_at_hours_ago": 30, "notes": "Title company confirming payoff amount." },
+      { "condition_id": "COND-DK-02",  "loan_id": "DK-022",      "description": "Reconsideration of appraised value",  "stage": "issued",       "entered_stage_at_hours_ago": 18, "notes": "ROV package being assembled." }
+    ],
+    "exceptions": [
+      { "exception_id": "TRID-014",  "loan_id": "DK-022",     "type": "TRID Tolerance",  "severity": "HIGH",   "stage": "under_review", "entered_stage_at_hours_ago": 40, "notes": "Fee tolerance cure required before CD can be redisclosed." },
+      { "exception_id": "RESPA-015", "loan_id": "DK-022",     "type": "RESPA/AfBA",     "severity": "MEDIUM", "stage": "flagged",      "entered_stage_at_hours_ago": 12, "notes": "Title/escrow affiliation disclosure under compliance review." },
+      { "exception_id": "HMDA-016",  "loan_id": "CRED-MR-002","type": "HMDA/LAR Data",  "severity": "LOW",    "stage": "flagged",      "entered_stage_at_hours_ago": 8,  "notes": "Rate spread field flagged for QC recheck." },
+      { "exception_id": "FRAUD-RK-006","loan_id":"DENY-SJ-001","type": "Fraud Review",  "severity": "HIGH",   "stage": "under_review", "entered_stage_at_hours_ago": 50, "notes": "File-review flags on VOE and pay stub under investigation." }
+    ]
+  }
+}
