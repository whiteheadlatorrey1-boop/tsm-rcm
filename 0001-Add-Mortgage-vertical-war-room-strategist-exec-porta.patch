+.topbar{height:42px;background:#0a0703;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 20px;}
+.tb-brand{font-family:'Orbitron',sans-serif;font-size:.7rem;color:var(--gold);letter-spacing:.15em;}
+.tb-time{font-family:'Orbitron',sans-serif;font-size:.75rem;color:var(--gold);}
+.hdr{padding:18px 24px;border-bottom:1px solid var(--border);background:var(--bg2);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;}
+.hdr-title{font-family:'Orbitron',sans-serif;font-size:1rem;letter-spacing:.08em;color:var(--text);}
+.hdr-sub{font-family:'JetBrains Mono',monospace;font-size:.65rem;color:var(--muted);margin-top:4px;}
+.hdr-btns{display:flex;gap:8px;flex-wrap:wrap;}
+.hbtn{background:var(--bg3);border:1px solid var(--border);color:var(--text);font-family:'JetBrains Mono',monospace;font-size:.62rem;padding:8px 14px;border-radius:4px;cursor:pointer;text-decoration:none;display:inline-block;}
+.hbtn:hover{border-color:var(--gold);color:var(--gold);}
+.hbtn.primary{border-color:var(--gold);color:var(--gold);}
+.wrap{max-width:1200px;margin:0 auto;padding:20px 24px;}
+.empty{text-align:center;padding:80px 20px;}
+.empty h2{font-family:'Orbitron',sans-serif;font-size:.9rem;color:var(--muted);letter-spacing:.08em;margin-bottom:14px;}
+.empty p{font-family:'JetBrains Mono',monospace;font-size:.7rem;color:var(--muted);margin-bottom:24px;}
+.kpi-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:20px;}
+.kpi{background:var(--bg2);border:1px solid var(--border);border-radius:6px;padding:16px;text-align:center;}
+.kpi-val{font-family:'Orbitron',sans-serif;font-size:1.3rem;font-weight:700;color:var(--orange);}
+.kpi-val.red{color:var(--red);}.kpi-val.green{color:var(--green);}.kpi-val.gold{color:var(--gold);}.kpi-val.amber{color:var(--amber);}
+.kpi-lbl{font-size:.6rem;color:var(--muted);margin-top:6px;font-family:'JetBrains Mono',monospace;letter-spacing:.08em;}
+.sec{background:var(--bg2);border:1px solid var(--border);border-radius:6px;padding:18px;margin-bottom:16px;}
+.sec-hdr{font-family:'Orbitron',sans-serif;font-size:.68rem;color:var(--gold);letter-spacing:.12em;margin-bottom:14px;display:flex;align-items:center;justify-content:space-between;gap:8px;}
+.sec-hdr .lbl::before{content:'\25C6';font-size:.55rem;margin-right:8px;}
+.sec-hdr-note{font-family:'JetBrains Mono',monospace;font-size:.58rem;color:var(--muted);text-transform:none;letter-spacing:0;}
+.ai-box{background:rgba(212,175,55,.06);border:1px solid var(--gold);border-radius:6px;padding:16px;margin-bottom:16px;white-space:pre-wrap;font-size:.88rem;line-height:1.55;}
+.ai-box table.md-table{border-collapse:collapse;width:100%;margin:8px 0;white-space:normal;}
+.ai-box table.md-table th,.ai-box table.md-table td{border:1px solid var(--border);padding:4px 6px;text-align:left;vertical-align:top;}
+.ai-box table.md-table th{color:var(--muted);text-transform:uppercase;font-size:.6rem;}
+.no-items{font-family:'JetBrains Mono',monospace;font-size:.7rem;color:var(--muted);}
+.toast{position:fixed;bottom:20px;right:20px;background:var(--bg2);border:1px solid var(--gold);color:var(--gold);padding:10px 18px;border-radius:4px;font-family:'JetBrains Mono',monospace;font-size:.65rem;opacity:0;pointer-events:none;transition:.3s;z-index:50;}
+.toast.show{opacity:1;transform:translateY(-4px);}
+
+.wip-board{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;}
+.wip-stage{background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:12px;text-align:center;position:relative;}
+.wip-stage.stalled{border-color:var(--red);background:rgba(239,68,68,.06);}
+.wip-stage .ws-lbl{font-family:'JetBrains Mono',monospace;font-size:.58rem;color:var(--muted);letter-spacing:.06em;text-transform:uppercase;margin-bottom:8px;min-height:26px;}
+.wip-stage .ws-count{font-family:'Orbitron',sans-serif;font-size:1.4rem;font-weight:700;color:var(--gold);}
+.wip-stage.stalled .ws-count{color:var(--red);}
+.wip-stage .ws-meta{font-family:'JetBrains Mono',monospace;font-size:.58rem;color:var(--muted);margin-top:6px;}
+.wip-stage .ws-flag{position:absolute;top:6px;right:8px;font-size:.55rem;color:var(--red);}
+.wip-arrow{display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:.9rem;}
+
+.aq-table{width:100%;border-collapse:collapse;font-size:.78rem;}
+.aq-table th{text-align:left;font-family:'JetBrains Mono',monospace;font-size:.58rem;color:var(--muted);letter-spacing:.06em;text-transform:uppercase;padding:6px 8px;border-bottom:1px solid var(--border);}
+.aq-table td{padding:9px 8px;border-bottom:1px solid #1a1608;vertical-align:top;}
+.aq-table tr:last-child td{border-bottom:none;}
+.impact{font-family:'JetBrains Mono',monospace;font-size:.55rem;font-weight:700;padding:2px 8px;border-radius:10px;white-space:nowrap;}
+.impact.high{background:rgba(239,68,68,.12);color:var(--red);border:1px solid var(--red);}
+.impact.medium{background:rgba(245,166,35,.12);color:var(--amber);border:1px solid var(--amber);}
+.impact.low{background:rgba(122,111,82,.12);color:var(--muted);border:1px solid var(--muted);}
+.time-hot{color:var(--red);font-weight:700;}
+.action-hint{color:var(--text);}
+</style>
+</head>
+<body>
+<div class="topbar">
+  <span class="tb-brand">TSM &middot; MORTGAGE COMMAND CENTER STRATEGIST</span>
+  <span class="tb-time" id="clock"></span>
+</div>
+<div class="hdr">
+  <div>
+    <div class="hdr-title" id="hdrTitle">&#127974; MORTGAGE COMMAND CENTER STRATEGIST</div>
+    <div class="hdr-sub" id="hdrSub">Awaiting relay from the Mortgage war room&hellip;</div>
+  </div>
+  <div class="hdr-btns">
+    <a class="hbtn" href="mortgage-war-room.html">&larr; War Room</a>
+    <a class="hbtn primary" href="mortgage-executive-portal.html">Executive View &rarr;</a>
+    <button class="hbtn" id="printBtn" onclick="window.print()">&darr; Export</button>
+  </div>
+</div>
+<div class="wrap" id="wrap"><!-- populated by JS --></div>
+<div class="toast" id="toast"></div>
+<script>
+function tick(){document.getElementById('clock').textContent=new Date().toLocaleTimeString();}
+setInterval(tick,1000);tick();
+
+const DOMAIN = 'MORTGAGE';
+const RELAY_KEY_FALLBACK = 'TSM_' + DOMAIN + '_RELAY';
+
+function showToast(msg){
+  const t=document.getElementById('toast');
+  t.textContent=msg; t.classList.add('show');
+  clearTimeout(showToast._h);
+  showToast._h=setTimeout(()=>t.classList.remove('show'),2500);
+}
+
+function loadRelay(){
+  try {
+    if(window.TSM && window.TSM.relay && window.TSM.relay.read){
+      const d = window.TSM.relay.read(DOMAIN);
+      if(d) return d;
+    }
+  } catch(e){}
+  try {
+    const raw = sessionStorage.getItem(RELAY_KEY_FALLBACK) || localStorage.getItem(RELAY_KEY_FALLBACK) || localStorage.getItem('TSM_MORTGAGE_STRATEGIST_RELAY');
+    return raw ? JSON.parse(raw) : null;
+  } catch(e){ return null; }
+}
+
+function escapeHtml(s){
+  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+}
+
+function fmtVal(v, fmt){
+  if(v===undefined || v===null || v==='') return '&mdash;';
+  if(fmt==='money') return '$' + Number(v).toLocaleString();
+  if(fmt==='pct') return v + '%';
+  return String(v);
+}
+
+function renderEmpty(){
+  document.getElementById('wrap').innerHTML = `
+    <div class="empty">
+      <h2>NO DATA RECEIVED</h2>
+      <p>Run an analysis in the Mortgage war room, then relay it here.</p>
+      <div class="hdr-btns" style="justify-content:center;">
+        <a class="hbtn primary" href="mortgage-war-room.html">&#127974; Go to War Room</a>
+      </div>
+    </div>`;
+}
+
+function renderEngineOutput(text) {
+  if(!text) return '';
+  const clean = text.replace(/KPI_JSON:\s*\{[^}]*\}\n*/i, '').trim();
+  const lines = clean.split('\n');
+  const isTableSep = l => /^\s*\|?[\s:|-]+\|?\s*$/.test(l) && l.includes('-');
+  const inlineFmt = s => escapeHtml(s).replace(/&lt;br\s*\/?&gt;/gi, '<br>').replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
+  const tables = [];
+  const outLines = [];
+  let i = 0;
+  while (i < lines.length) {
+    const line = lines[i];
+    if (/^\s*\|.*\|\s*$/.test(line) && lines[i + 1] !== undefined && isTableSep(lines[i + 1])) {
+      const headers = line.trim().replace(/^\||\|$/g, '').split('|').map(c => c.trim());
+      let t = '<table class="md-table"><thead><tr>' + headers.map(c => `<th>${inlineFmt(c)}</th>`).join('') + '</tr></thead><tbody>';
+      i += 2;
+      while (i < lines.length && /^\s*\|.*\|\s*$/.test(lines[i])) {
+        const cells = lines[i].trim().replace(/^\||\|$/g, '').split('|').map(c => c.trim());
+        t += '<tr>' + cells.map(c => `<td>${inlineFmt(c)}</td>`).join('') + '</tr>';
+        i++;
+      }
+      t += '</tbody></table>';
+      outLines.push(`@@TABLE${tables.length}@@`);
+      tables.push(t);
+      continue;
+    }
+    outLines.push(line);
+    i++;
+  }
+  let html = escapeHtml(outLines.join('\n'));
+  html = html.replace(/&lt;br\s*\/?&gt;/gi, '<br>');
+  html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
+  html = html.replace(/^▸\s*(.+)$/gm, '<div style="margin:4px 0">▸ $1</div>');
+  html = html.replace(/^(\d+)\.\s+(.+)$/gm, '<div style="margin:4px 0 4px 8px"><strong>$1.</strong> $2</div>');
+  html = html.replace(/\n{2,}/g, '<br><br>').replace(/\n/g, '<br>');
+  tables.forEach((t, idx) => { html = html.replace(`@@TABLE${idx}@@`, t); });
+  return html;
+}
+
+/* ---------- Business-value framing helpers ---------- */
+
+// Deterministic, rule-based next action -- derived from stage + breach
+// status + ownership, never invented.
+function nextAction(rec, isBreached){
+  const owner = rec.owner || 'Unassigned';
+  if(rec.stage === 'application' && owner === 'Unassigned') return 'Assign a processor and begin file setup now.';
+  if(rec.stage === 'application') return 'Continue intake against SLA clock.';
+  if(rec.stage === 'processing' && isBreached) return 'Processing stalled past SLA \u2014 escalate to processing lead.';
+  if(rec.stage === 'processing') return 'Continue document collection; monitor against SLA clock.';
+  if(rec.stage === 'underwriting' && isBreached) return 'Underwriting past SLA \u2014 escalate to UW manager.';
+  if(rec.stage === 'underwriting') return 'Awaiting UW decision; confirm queue position.';
+  if(rec.stage === 'conditions' && isBreached) return 'Conditions stalled past SLA \u2014 follow up with borrower/processor today.';
+  if(rec.stage === 'conditions') return 'Track condition clearance against SLA clock.';
+  if(rec.stage === 'clear_to_close') return 'Confirm CD accuracy and schedule closing.';
+  if(rec.stage === 'denied') return 'Review for alternative program or reconsideration of value.';
+  return 'Confirm status and close out.';
+}
+
+function impactFromSeverity(sev){
+  if(sev === 'HIGH') return { cls: 'high', label: 'HIGH IMPACT' };
+  if(sev === 'MEDIUM') return { cls: 'medium', label: 'MED IMPACT' };
+  return { cls: 'low', label: 'LOW IMPACT' };
+}
+
+function renderWipBoard(wip){
+  if(!wip || !wip.length) return '';
+  const stages = wip.map(s => {
+    const stalled = s.stalled_count > 0;
+    const meta = s.avg_hours_in_stage !== null
+      ? `avg ${s.avg_hours_in_stage}h in stage${s.sla_hours!=null ? ' / SLA '+s.sla_hours+'h' : ''}`
+      : (s.sla_hours!=null ? `SLA ${s.sla_hours}h` : 'no SLA clock');
+    return `<div class="wip-stage${stalled?' stalled':''}">
+      ${stalled?'<span class="ws-flag">&#9888;</span>':''}
+      <div class="ws-lbl">${escapeHtml(s.label)}</div>
+      <div class="ws-count">${s.count}</div>
+      <div class="ws-meta">${escapeHtml(meta)}</div>
+      ${stalled?`<div class="ws-meta" style="color:var(--red)">${s.stalled_count} stalled past SLA</div>`:''}
+    </div>`;
+  }).join('<div class="wip-arrow">&rarr;</div>');
+  return `<div class="sec">
+    <div class="sec-hdr"><span class="lbl">LOAN FILE PIPELINE BY STAGE</span><span class="sec-hdr-note">time-in-stage vs. SLA clock, live from war room data</span></div>
+    <div class="wip-board">${stages}</div>
+  </div>`;
+}
+
+function renderActionQueue(records, breachIds){
+  const loans = (records && records.loan_files) || [];
+  const open = loans.filter(r => !['funded','denied'].includes(r.stage));
+  if(!open.length){
+    return `<div class="sec"><div class="sec-hdr"><span class="lbl">ACTION QUEUE</span></div><div class="no-items">No open loan files &mdash; queue is clear.</div></div>`;
+  }
+  const rows = open
+    .slice()
+    .sort((a,b) => (b.entered_stage_at_hours_ago||0) - (a.entered_stage_at_hours_ago||0))
+    .map(r => {
+      const isBreached = breachIds.has(r.loan_id);
+      const impact = impactFromSeverity(r.severity);
+      const hours = r.entered_stage_at_hours_ago;
+      return `<tr>
+        <td><strong>${escapeHtml(r.loan_id)}</strong><br><span style="color:var(--muted);font-size:.7rem;">${escapeHtml(r.borrower||'')} &middot; ${escapeHtml(r.program||'')}</span></td>
+        <td><span class="impact ${impact.cls}">${impact.label}</span></td>
+        <td>${escapeHtml(r.stage)}</td>
+        <td class="${isBreached?'time-hot':''}">${hours!==undefined?hours+'h':'&mdash;'}</td>
+        <td>${escapeHtml(r.owner||'Unassigned')}</td>
+        <td class="action-hint">${escapeHtml(nextAction(r, isBreached))}</td>
+      </tr>`;
+    }).join('');
+  return `<div class="sec">
+    <div class="sec-hdr"><span class="lbl">ACTION QUEUE</span><span class="sec-hdr-note">ranked by time in current stage</span></div>
+    <table class="aq-table">
+      <thead><tr><th>Loan File</th><th>Impact</th><th>Stage</th><th>Time in Stage</th><th>Owner</th><th>Recommended Next Step</th></tr></thead>
+      <tbody>${rows}</tbody>
+    </table>
+  </div>`;
+}
+
+function render(){
+  const data = loadRelay();
+  if(!data){ renderEmpty(); return; }
+
+  document.getElementById('hdrSub').textContent = `Relayed ${data.timestamp ? new Date(data.timestamp).toLocaleString() : '&mdash;'}`;
+
+  const kpis = data.kpis || {};
+  const breaches = data.loan_breaches || [];
+  const breachIds = new Set(breaches.map(b => b.id));
+  const openLoans = kpis.open_loan_files || 0;
+  const compliancePct = openLoans > 0
+    ? Math.round(((openLoans - breaches.length) / openLoans) * 1000) / 10
+    : 100;
+
+  let html = '';
+
+  html += `<div class="kpi-row">
+    <div class="kpi"><div class="kpi-val amber">${fmtVal(kpis.open_loan_files)}</div><div class="kpi-lbl">OPEN LOAN FILES</div></div>
+    <div class="kpi"><div class="kpi-val red">${fmtVal(kpis.loans_over_sla)}</div><div class="kpi-lbl">LOANS OVER SLA</div></div>
+    <div class="kpi"><div class="kpi-val ${compliancePct>=90?'green':compliancePct>=70?'amber':'red'}">${compliancePct}%</div><div class="kpi-lbl">SLA COMPLIANCE</div></div>
+    <div class="kpi"><div class="kpi-val gold">${fmtVal(kpis.ctc_ready)}</div><div class="kpi-lbl">CTC READY</div></div>
+    <div class="kpi"><div class="kpi-val amber">${fmtVal(kpis.open_conditions)}</div><div class="kpi-lbl">OPEN UW CONDITIONS</div></div>
+    <div class="kpi"><div class="kpi-val red">${fmtVal(kpis.open_exceptions)}</div><div class="kpi-lbl">OPEN COMPLIANCE FLAGS</div></div>
+  </div>`;
+
+  if(data.ai_summary){
+    html += `<div class="ai-box"><strong style="color:var(--gold);font-family:'Orbitron',sans-serif;font-size:.65rem;letter-spacing:.1em;display:block;margin-bottom:8px;">AI PIPELINE ANALYSIS</strong>${renderEngineOutput(data.ai_summary)}</div>`;
+  }
+
+  html += renderWipBoard(data.loan_wip);
+  html += renderActionQueue(data.records, breachIds);
+
+  document.getElementById('wrap').innerHTML = html;
+}
+
+render();
+window.addEventListener('storage', e => { if(e.key === RELAY_KEY_FALLBACK || e.key === 'TSM_EVENT_LOG') render(); });
+window.addEventListener('TSM_RELAY_EVENT', e => { if(e.detail && e.detail.domain === DOMAIN) render(); });
+</script>
+  <script src="/html/war-rooms/_relay_control_plane/relay.core.js"></script>
+  <script src="/html/core/tsm-runtime.js"></script>
+</body>
+</html>
