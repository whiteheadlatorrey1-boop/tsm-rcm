+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="UTF-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>TSM &middot; Mortgage Command Center Executive Portal</title>
+<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
+<style>
+:root{
+  --bg:#0d0a04;--bg2:#120e07;--bg3:#17130a;
+  --amber:#f5a623;--green:#22c55e;
+  --red:#ef4444;--purple:#a855f7;--blue:#3b82f6;
+  --orange:#f97316;--text:#f2e8d0;--muted:#7a6f52;--border:#2a2412;
+  --gold:#e8c15a;
+}
+*{margin:0;padding:0;box-sizing:border-box;}
+body{background:var(--bg);color:var(--text);font-family:'Rajdhani',sans-serif;min-height:100vh;padding-bottom:60px;}
+.topbar{height:42px;background:#0a0703;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 20px;}
+.tb-brand{font-family:'Orbitron',sans-serif;font-size:.7rem;color:var(--gold);letter-spacing:.15em;}
+.tb-time{font-family:'Orbitron',sans-serif;font-size:.75rem;color:var(--gold);}
+.hdr{padding:18px 24px;border-bottom:1px solid var(--border);background:var(--bg2);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;}
+.hdr-title{font-family:'Orbitron',sans-serif;font-size:1rem;letter-spacing:.08em;color:var(--text);}
+.hdr-sub{font-family:'JetBrains Mono',monospace;font-size:.65rem;color:var(--muted);margin-top:4px;}
+.hdr-btns{display:flex;gap:8px;flex-wrap:wrap;}
+.hbtn{background:var(--bg3);border:1px solid var(--border);color:var(--text);font-family:'JetBrains Mono',monospace;font-size:.62rem;padding:8px 14px;border-radius:4px;cursor:pointer;text-decoration:none;display:inline-block;}
+.hbtn:hover{border-color:var(--gold);color:var(--gold);}
+.hbtn.primary{border-color:var(--gold);color:var(--gold);}
+.wrap{max-width:1200px;margin:0 auto;padding:20px 24px;}
+.empty{text-align:center;padding:80px 20px;}
+.empty h2{font-family:'Orbitron',sans-serif;font-size:.9rem;color:var(--muted);letter-spacing:.08em;margin-bottom:14px;}
+.empty p{font-family:'JetBrains Mono',monospace;font-size:.7rem;color:var(--muted);margin-bottom:24px;}
+.sec{background:var(--bg2);border:1px solid var(--border);border-radius:6px;padding:18px;margin-bottom:16px;}
+.sec-hdr{font-family:'Orbitron',sans-serif;font-size:.68rem;color:var(--gold);letter-spacing:.12em;margin-bottom:14px;display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;}
+.sec-hdr .lbl::before{content:'\25C6';font-size:.55rem;margin-right:8px;}
+.sec-hdr-note{font-family:'JetBrains Mono',monospace;font-size:.58rem;color:var(--muted);text-transform:none;letter-spacing:0;}
+.no-items{font-family:'JetBrains Mono',monospace;font-size:.7rem;color:var(--muted);}
+.toast{position:fixed;bottom:20px;right:20px;background:var(--bg2);border:1px solid var(--gold);color:var(--gold);padding:10px 18px;border-radius:4px;font-family:'JetBrains Mono',monospace;font-size:.65rem;opacity:0;pointer-events:none;transition:.3s;z-index:50;}
+.toast.show{opacity:1;transform:translateY(-4px);}
+
+.fin-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px;margin-bottom:16px;}
+.fin-card{background:var(--bg2);border:1px solid var(--border);border-radius:6px;padding:18px;text-align:center;}
+.fin-card.hero{border-color:var(--gold);background:rgba(232,193,90,.06);}
+.fin-val{font-family:'Orbitron',sans-serif;font-size:1.6rem;font-weight:900;color:var(--gold);}
+.fin-val.red{color:var(--red);}.fin-val.green{color:var(--green);}.fin-val.blue{color:var(--blue);}
+.fin-lbl{font-size:.62rem;color:var(--muted);margin-top:8px;font-family:'JetBrains Mono',monospace;letter-spacing:.08em;}
+.fin-sub{font-size:.58rem;color:var(--muted);margin-top:4px;font-family:'JetBrains Mono',monospace;}
+.model-note{font-family:'JetBrains Mono',monospace;font-size:.6rem;color:var(--muted);border-top:1px solid var(--border);padding-top:10px;margin-top:6px;}
+
+.funnel{display:flex;flex-direction:column;gap:6px;}
+.funnel-row{display:grid;grid-template-columns:130px 1fr 90px 110px;gap:10px;align-items:center;font-size:.75rem;}
+.funnel-row .fr-lbl{font-family:'JetBrains Mono',monospace;font-size:.62rem;color:var(--text);}
+.funnel-bar-wrap{background:var(--bg3);border-radius:4px;height:22px;overflow:hidden;position:relative;}
+.funnel-bar{height:100%;background:linear-gradient(90deg,var(--gold),var(--orange));display:flex;align-items:center;padding-left:8px;font-family:'JetBrains Mono',monospace;font-size:.6rem;color:#1a1200;font-weight:700;white-space:nowrap;}
+.funnel-bar.empty-bar{background:var(--bg3);}
+.fr-hours{font-family:'JetBrains Mono',monospace;font-size:.62rem;color:var(--muted);text-align:right;}
+.fr-exposure{font-family:'JetBrains Mono',monospace;font-size:.65rem;text-align:right;color:var(--red);font-weight:700;}
+.funnel-hdr{display:grid;grid-template-columns:130px 1fr 90px 110px;gap:10px;font-family:'JetBrains Mono',monospace;font-size:.55rem;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:4px;}
+.funnel-hdr .align-r{text-align:right;}
+
+.risk-item{display:flex;gap:14px;align-items:flex-start;padding:12px 0;border-bottom:1px solid #1a1608;}
+.risk-item:last-child{border-bottom:none;}
+.risk-rank{font-family:'Orbitron',sans-serif;font-size:1.1rem;font-weight:900;color:var(--gold);width:28px;flex-shrink:0;}
+.risk-body{flex:1;}
+.risk-title{font-size:.85rem;color:var(--text);margin-bottom:4px;}
+.risk-title b{color:var(--red);}
+.risk-action{font-family:'JetBrains Mono',monospace;font-size:.65rem;color:var(--muted);}
+.risk-amount{font-family:'Orbitron',sans-serif;font-size:1rem;font-weight:700;color:var(--red);white-space:nowrap;}
+
+.action-bar{display:flex;gap:10px;flex-wrap:wrap;margin-top:4px;}
+.abtn{font-family:'Orbitron',sans-serif;font-size:.65rem;letter-spacing:.08em;padding:10px 18px;border-radius:4px;cursor:pointer;border:1px solid var(--border);background:var(--bg3);color:var(--text);}
+.abtn.approve{border-color:var(--green);color:var(--green);}
+.abtn.escalate{border-color:var(--red);color:var(--red);}
+.abtn:hover{opacity:.85;}
+.ai-box{background:rgba(232,193,90,.06);border:1px solid var(--gold);border-radius:6px;padding:22px;margin-bottom:16px;white-space:pre-wrap;font-size:.95rem;line-height:1.55;}
+.ai-box table.md-table{border-collapse:collapse;width:100%;margin:8px 0;white-space:normal;}
+.ai-box table.md-table th,.ai-box table.md-table td{border:1px solid var(--border);padding:4px 6px;text-align:left;vertical-align:top;}
+.ai-box table.md-table th{color:var(--muted);text-transform:uppercase;font-size:.6rem;}
+</style>
+</head>
+<body>
+<div class="topbar">
+  <span class="tb-brand">TSM &middot; MORTGAGE COMMAND CENTER EXECUTIVE PORTAL</span>
+  <span class="tb-time" id="clock"></span>
+</div>
+<div class="hdr">
+  <div>
+    <div class="hdr-title" id="hdrTitle">&#128188; MORTGAGE COMMAND CENTER EXECUTIVE PORTAL</div>
+    <div class="hdr-sub" id="hdrSub">Awaiting relay from the Mortgage war room&hellip;</div>
+  </div>
+  <div class="hdr-btns">
+    <a class="hbtn" href="mortgage-war-room.html">&larr; War Room</a>
+    <a class="hbtn primary" href="mortgage-strategist.html">Strategist View &rarr;</a>
+    <button class="hbtn" id="printBtn" onclick="window.print()">&darr; Export</button>
+  </div>
+</div>
+<div class="wrap" id="wrap"><!-- populated by JS --></div>
+<div class="toast" id="toast"></div>
+<script>
+function tick(){document.getElementById('clock').textContent=new Date().toLocaleTimeString();}
+setInterval(tick,1000);tick();
+
+const DOMAIN = 'MORTGAGE';
+const RELAY_KEY_FALLBACK = 'TSM_' + DOMAIN + '_RELAY';
+
+function showToast(msg){
+  const t=document.getElementById('toast');
+  t.textContent=msg; t.classList.add('show');
+  clearTimeout(showToast._h);
+  showToast._h=setTimeout(()=>t.classList.remove('show'),2500);
+}
+
+function loadRelay(){
+  try {
+    if(window.TSM && window.TSM.relay && window.TSM.relay.read){
+      const d = window.TSM.relay.read(DOMAIN);
+      if(d) return d;
+    }
+  } catch(e){}
+  try {
+    const raw = sessionStorage.getItem(RELAY_KEY_FALLBACK) || localStorage.getItem(RELAY_KEY_FALLBACK) || localStorage.getItem('TSM_MORTGAGE_STRATEGIST_RELAY');
+    return raw ? JSON.parse(raw) : null;
+  } catch(e){ return null; }
+}
+
+function escapeHtml(s){
+  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+}
+
+function money(n, currency){
+  const sym = (currency === 'USD' || !currency) ? '$' : (currency + ' ');
+  return sym + Math.round(n||0).toLocaleString();
+}
+
+function renderEmpty(){
+  document.getElementById('wrap').innerHTML = `
+    <div class="empty">
+      <h2>NO DATA RECEIVED</h2>
+      <p>Run an analysis in the Mortgage war room, then relay it here.</p>
+      <div class="hdr-btns" style="justify-content:center;">
+        <a class="hbtn primary" href="mortgage-war-room.html">&#127974; Go to War Room</a>
+      </div>
+    </div>`;
+}
+
+function renderEngineOutput(text) {
+  if(!text) return '';
+  const clean = text.replace(/KPI_JSON:\s*\{[^}]*\}\n*/i, '').trim();
+  const lines = clean.split('\n');
+  const isTableSep = l => /^\s*\|?[\s:|-]+\|?\s*$/.test(l) && l.includes('-');
+  const inlineFmt = s => escapeHtml(s).replace(/&lt;br\s*\/?&gt;/gi, '<br>').replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
+  const tables = [];
+  const outLines = [];
+  let i = 0;
+  while (i < lines.length) {
+    const line = lines[i];
+    if (/^\s*\|.*\|\s*$/.test(line) && lines[i + 1] !== undefined && isTableSep(lines[i + 1])) {
+      const headers = line.trim().replace(/^\||\|$/g, '').split('|').map(c => c.trim());
+      let t = '<table class="md-table"><thead><tr>' + headers.map(c => `<th>${inlineFmt(c)}</th>`).join('') + '</tr></thead><tbody>';
+      i += 2;
+      while (i < lines.length && /^\s*\|.*\|\s*$/.test(lines[i])) {
+        const cells = lines[i].trim().replace(/^\||\|$/g, '').split('|').map(c => c.trim());
+        t += '<tr>' + cells.map(c => `<td>${inlineFmt(c)}</td>`).join('') + '</tr>';
+        i++;
+      }
+      t += '</tbody></table>';
+      outLines.push(`@@TABLE${tables.length}@@`);
+      tables.push(t);
+      continue;
+    }
+    outLines.push(line);
+    i++;
+  }
+  let html = escapeHtml(outLines.join('\n'));
+  html = html.replace(/&lt;br\s*\/?&gt;/gi, '<br>');
+  html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
+  html = html.replace(/^▸\s*(.+)$/gm, '<div style="margin:4px 0">▸ $1</div>');
+  html = html.replace(/^(\d+)\.\s+(.+)$/gm, '<div style="margin:4px 0 4px 8px"><strong>$1.</strong> $2</div>');
+  html = html.replace(/\n{2,}/g, '<br><br>').replace(/\n/g, '<br>');
+  tables.forEach((t, idx) => { html = html.replace(`@@TABLE${idx}@@`, t); });
+  return html;
+}
+
+/* ---------- CFO / RCM framing helpers ---------- */
+
+function execAction(sev){
+  if(sev === 'HIGH') return 'Escalate to closing manager now \u2014 delay and compliance exposure compounding daily.';
+  if(sev === 'MEDIUM') return 'Confirm remediation ETA with processing; escalate if unresolved this week.';
+  return 'Monitor \u2014 low board-level exposure at current pace.';
+}
+
+function renderFinancials(fin){
+  if(!fin) return '';
+  const total = fin.total_exposure || 0;
+  return `<div class="fin-row">
+    <div class="fin-card hero">
+      <div class="fin-val">${money(total, fin.currency)}</div>
+      <div class="fin-lbl">TOTAL EXPOSURE</div>
+      <div class="fin-sub">Closing delay + compliance exposure, current pipeline</div>
+    </div>
+    <div class="fin-card">
+      <div class="fin-val red">${money(fin.closing_delay_exposure_total, fin.currency)}</div>
+      <div class="fin-lbl">CLOSING DELAY EXPOSURE</div>
+      <div class="fin-sub">${(fin.closing_delay_exposure_items||[]).length} loan file(s) over SLA</div>
+    </div>
+    <div class="fin-card">
+      <div class="fin-val red">${money(fin.compliance_exposure_total, fin.currency)}</div>
+      <div class="fin-lbl">COMPLIANCE EXPOSURE</div>
+      <div class="fin-sub">${(fin.compliance_exposure_items||[]).length} open exception(s)</div>
+    </div>
+    <div class="fin-card">
+      <div class="fin-val blue">${money(fin.pipeline_value, fin.currency)}</div>
+      <div class="fin-lbl">PIPELINE VALUE</div>
+      <div class="fin-sub">Total open loan amount in pipeline</div>
+    </div>
+  </div>
+  ${fin.note ? `<div class="model-note">&#9432; ${escapeHtml(fin.note)}</div>` : ''}`;
+}
+
+function renderFunnel(wip, fin){
+  if(!wip || !wip.length) return '';
+  const expByStage = {};
+  (fin && fin.closing_delay_exposure_items || []).forEach(it => {
+    expByStage[it.stage] = (expByStage[it.stage] || 0) + it.exposure;
+  });
+  const maxCount = Math.max(1, ...wip.map(s => s.count));
+  const rows = wip.map(s => {
+    const pct = Math.round((s.count / maxCount) * 100);
+    const exposure = expByStage[s.label] || 0;
+    return `<div class="funnel-row">
+      <div class="fr-lbl">${escapeHtml(s.label)}</div>
+      <div class="funnel-bar-wrap"><div class="funnel-bar${s.count===0?' empty-bar':''}" style="width:${Math.max(pct,s.count?12:0)}%">${s.count} file${s.count===1?'':'s'}</div></div>
+      <div class="fr-hours">${s.avg_hours_in_stage!==null ? s.avg_hours_in_stage+'h avg' : '&mdash;'}</div>
+      <div class="fr-exposure">${exposure>0?money(exposure, fin&&fin.currency):'&mdash;'}</div>
+    </div>`;
+  }).join('');
+  return `<div class="sec">
+    <div class="sec-hdr"><span class="lbl">LOAN LIFECYCLE (PIPELINE VIEW)</span><span class="sec-hdr-note">Application &rarr; Processing &rarr; Underwriting &rarr; Conditions &rarr; Clear to Close &rarr; Funded/Denied</span></div>
+    <div class="funnel-hdr"><span>Stage</span><span>Volume</span><span class="align-r">Avg Time</span><span class="align-r">$ Exposure</span></div>
+    <div class="funnel">${rows}</div>
+  </div>`;
+}
+
+function renderRiskRegister(fin){
+  const items = (fin && fin.closing_delay_exposure_items) || [];
+  if(!items.length){
+    return `<div class="sec"><div class="sec-hdr"><span class="lbl">TOP RISK REGISTER</span></div><div class="no-items">No SLA-breaching exposure right now &mdash; nothing to escalate to the board.</div></div>`;
+  }
+  const top3 = items.slice(0,3);
+  const rows = top3.map((it, idx) => `
+    <div class="risk-item">
+      <div class="risk-rank">${idx+1}</div>
+      <div class="risk-body">
+        <div class="risk-title"><b>${escapeHtml(it.stage)}</b> &middot; ${escapeHtml(it.id)} &mdash; ${escapeHtml(it.borrower||'')} (${it.days_over}d over SLA)</div>
+        <div class="risk-action">${escapeHtml(execAction(it.days_over > 3 ? 'HIGH' : 'MEDIUM'))}</div>
+      </div>
+      <div class="risk-amount">${money(it.exposure, fin.currency)}</div>
+    </div>`).join('');
+  return `<div class="sec">
+    <div class="sec-hdr"><span class="lbl">TOP RISK REGISTER</span><span class="sec-hdr-note">ranked by $ exposure</span></div>
+    ${rows}
+  </div>`;
+}
+
+function render(){
+  const data = loadRelay();
+  if(!data){ renderEmpty(); return; }
+
+  document.getElementById('hdrSub').textContent = `Relayed ${data.timestamp ? new Date(data.timestamp).toLocaleString() : '&mdash;'}`;
+
+  let html = '';
+  html += renderFinancials(data.financials);
+
+  if(data.ai_summary){
+    html += `<div class="ai-box"><strong style="color:var(--gold);font-family:'Orbitron',sans-serif;font-size:.65rem;letter-spacing:.1em;display:block;margin-bottom:8px;">EXECUTIVE RECOMMENDATION</strong>${renderEngineOutput(data.ai_summary)}</div>`;
+  }
+
+  html += renderRiskRegister(data.financials);
+  html += renderFunnel(data.loan_wip, data.financials);
+
+  html += `<div class="sec"><div class="sec-hdr"><span class="lbl">EXECUTIVE ACTIONS</span></div>
+    <div class="action-bar">
+      <button class="abtn approve" onclick="showToast('Marked reviewed \u2014 no downstream write in this demo build.')">&#10003; ACKNOWLEDGE</button>
+      <button class="abtn escalate" onclick="showToast('Escalation flagged \u2014 notify closing manager.')">&#8593; ESCALATE</button>
+    </div>
+  </div>`;
+
+  document.getElementById('wrap').innerHTML = html;
+}
+
+render();
+window.addEventListener('storage', e => { if(e.key === RELAY_KEY_FALLBACK || e.key === 'TSM_EVENT_LOG') render(); });
+window.addEventListener('TSM_RELAY_EVENT', e => { if(e.detail && e.detail.domain === DOMAIN) render(); });
+</script>
+  <script src="/html/war-rooms/_relay_control_plane/relay.core.js"></script>
+  <script src="/html/core/tsm-runtime.js"></script>
+</body>
+</html>
