From f490564230662fdd92f7820d4861a7d10700adc9 Mon Sep 17 00:00:00 2001
From: Latorrey Whitehead <torreyw94@tsmatter.com>
Date: Sun, 2 Aug 2026 17:26:51 +0000
Subject: [PATCH] feat(demo): add BPO demo spec

Follows the healthcare-demo.json/spec.js pattern, adapted for
bpo-war-room.html's actual auto-demo-mode behavior: loadRelay()
auto-falls-back to the supplier-shutdown demo scenario and
auto-fires the extraction engine when no relay/sessionStorage data
is present (the normal state for a fresh session) -- no manual
doc-load click needed there. Route to strategist -> generate
strategy brief (manual click, no relay data to auto-run it here) ->
escalate to executive portal (disabled until the brief completes) ->
KPIs + explainability panel.

Selectors read directly from bpo-war-room.html / bpo-strategist.html
/ bpo-executive-portal.html (ids, onclick handlers, functions) --
NOT live-verified via Playwright, since this sandbox hits the same
chrome-headless-shell 403 as the Codespace. Flagged in the spec's
own note field; should be run once in Codespaces to confirm before
treating as final.
---
 demo/bpo-demo.json              | 21 +++++++++++++++++++++
 tests/e2e/demo/bpo-demo.spec.js | 20 ++++++++++++++++++++
 2 files changed, 41 insertions(+)
 create mode 100644 demo/bpo-demo.json
 create mode 100644 tests/e2e/demo/bpo-demo.spec.js

diff --git a/demo/bpo-demo.json b/demo/bpo-demo.json
new file mode 100644
index 00000000..76d6a550
--- /dev/null
+++ b/demo/bpo-demo.json
@@ -0,0 +1,21 @@
+{
+  "vertical": "bpo",
+  "note": "Source-verified 2026-08-02 against whiteheadlatorrey1-boop/tsm-rcm (html/war-rooms/bpo-war/bpo-war-room.html + bpo-strategist.html + bpo-executive-portal.html) by reading real ids/onclick handlers/functions directly -- NOT live-verified via Playwright (this sandbox hits the same chrome-headless-shell 403 as the Codespace). Unlike FinOps/Construction, bpo-war-room.html's loadRelay() IIFE auto-falls-back to loadDemoMode() (supplier-shutdown scenario) when no relay/sessionStorage data is present -- which is the normal state for a fresh Playwright session -- and auto-fires the extraction engine ~1000ms after load, so no manual doc-load/fire click is needed on the war room itself. routeToStrategist() also self-heals: if the engine somehow hasn't fired yet it fires it first before navigating. On the strategist page, fireStrategy() is NOT auto-run without existing relay data, so #fireStratBtn must be clicked manually; escalateToExec() (#escalateBtn) stays disabled until that completes. Run once in Codespaces and correct any selector drift before treating as final.",
+  "steps": [
+    { "shot": "001-war-room-demo-load", "goto": "/html/war-rooms/bpo-war/bpo-war-room.html", "waitMs": 2500 },
+
+    { "shot": "002-engine-auto-fired", "waitFor": "#engineCount", "waitMs": 4000 },
+
+    { "shot": "003-route-to-strategist", "click": "#routeBtn", "waitMs": 2000 },
+
+    { "shot": "004-strategist-load", "waitFor": "#fireStratBtn", "waitMs": 800 },
+
+    { "shot": "005-generate-strategy-brief", "click": "#fireStratBtn", "waitFor": "#reasoningBox", "waitMs": 4500 },
+
+    { "shot": "006-escalate-to-exec", "click": "#escalateBtn", "waitMs": 2000 },
+
+    { "shot": "007-exec-portal-kpis", "waitFor": "#kpiStrategy", "waitMs": 800 },
+
+    { "shot": "008-exec-explainability", "waitFor": ".tsmk-explain", "waitMs": 600 }
+  ]
+}
diff --git a/tests/e2e/demo/bpo-demo.spec.js b/tests/e2e/demo/bpo-demo.spec.js
new file mode 100644
index 00000000..d8b239c3
--- /dev/null
+++ b/tests/e2e/demo/bpo-demo.spec.js
@@ -0,0 +1,20 @@
+const { test } = require('@playwright/test');
+const path = require('path');
+const { runStory, loadStory } = require('../../../demo/demo-engine');
+
+// Point this at your running TSM server (Codespace forwarded port or localhost).
+const BASE_URL = process.env.TSM_BASE_URL || 'http://localhost:8080';
+
+test('BPO executive demo', async ({ page }) => {
+  await page.setViewportSize({ width: 1920, height: 1080 });
+  test.setTimeout(120_000);
+
+  const story = loadStory(path.join(__dirname, '../../../demo/bpo-demo.json'));
+  const outDir = path.join(__dirname, 'screenshots', 'bpo');
+
+  await runStory(page, {
+    steps: story.steps,
+    outDir,
+    baseURL: BASE_URL,
+  });
+});
-- 
