{
  "version": "1.0",
  "pattern": "^TSM_[A-Z0-9_]+_RELAY$",
  "allowed_prefixes": [
    "TSM_APPROVAL",
    "TSM_BPO",
    "TSM_CRM",
    "TSM_CATALOG",
    "TSM_CPQ",
    "TSM_GOVERNANCE",
    "TSM_MDM",
    "TSM_O2C",
    "TSM_HONEYWELL",
    "TSM_DIGITAL_TWIN",
    "TSM_INTEGRATION_HUB",
    "TSM_HC_WAR",
    "TSM_INS_WAR",
    "TSM_RE_WAR",
    "TSM_CONSTRUCTION_WAR",
    "TSM_LEGAL_WAR"
  ],
  "rules": {
    "no_hyphens": true,
    "underscore_only": true,
    "must_end_with": "_RELAY"
  }
}
