 function launchEP() {
-  // Store relay data for EP
+  // Store relay data for EP — matches the shape legal-executive-portal.html's
+  // loadStrategistRelay() actually reads (TSM_STRATEGIST_RELAY). Fields we
+  // don't have real data for (exposure, winProb) are left unset rather than
+  // invented; the portal already handles missing fields gracefully.
   const scenario = SCENARIOS[currentScenario];
+  const riskScore = Math.max(...Object.values(scenario.scores));
   const payload = {
-    bnca: lastBNCA,
-    scenario: scenario.name,
-    risk: scenario.risk,
+    ts: Date.now(),
     matter: document.getElementById('matter-name').value || '',
-    relayTime: new Date().toISOString()
+    docType: scenario.name,
+    synthesisText: lastBNCA,
+    riskScore,
+    enginesCount: scenario.nodes.length
   };
-  try { sessionStorage.setItem('tsm_legal_relay', JSON.stringify(payload)); } catch(e){}
-  window.location.href = '/legal-pro/ep1.html';
+  try { sessionStorage.setItem('TSM_STRATEGIST_RELAY', JSON.stringify(payload)); } catch(e){}
+  window.location.href = '/war-rooms/legal-war/legal-executive-portal.html';
 }
 
