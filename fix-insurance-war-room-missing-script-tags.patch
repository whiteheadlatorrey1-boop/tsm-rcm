-  TSM INSURANCE WAR ROOM — MISSION DISPATCH PATCH
-  Add this block just before   <script src="/js/core/tsm-kernel-upgrade.js"></script>
 <script src="/js/tsm-autorun-engine.js"></script>
 <script src="/html/shared/js/tsm-assistant-widget.js"></script>
-  <script src="/html/core/tsm-runtime.js"></script>
-</body> in insurance-war-room.html
-  Also add the mission guide script tag at the top of this block.
-  ============================================================ -->
+<script src="/html/core/tsm-runtime.js"></script>
 
 <script src="/js/tsm-mission-guide.js"></script>
 
@@ -1958,6 +1954,7 @@ window.insHowtoOpen = () => document.getElementById('insHowtoOverlay').classList
   </div>
 </div>
 
