@@ -0,0 +1,23 @@
+{
+  "vertical": "schools",
+  "note": "Source-verified 2026-08-02 against whiteheadlatorrey1-boop/tsm-rcm (html/war-rooms/schools-command/schools-command.html + schools-strategist.html + schools-executive-portal.html) by reading real ids/onclick handlers/functions directly -- NOT live-verified via Playwright (this sandbox hits the same chrome-headless-shell 403 as the Codespace). Command Center is a single-page tabbed app (switchTab('ai') opens the AI Analysis tab, panel id tab-ai) with a left-hand prompt library (loadPrompt(...) onclick handlers) feeding a shared #ai-input textarea; RUN AI ANALYSIS is button#schBtnRunAnalysis, output renders into #ai-output, and schRunAnalysis() internally calls schWriteRelay() to push to the relay control plane -- there is no separate manual relay button. Strategist and Executive Portal are both auto-rendering (render()/#wrap innerHTML from relay data on page load, storage + TSM_RELAY_EVENT listeners for live updates) and link to each other via plain <a class=hbtn> anchors, same as Mortgage. FIX INCLUDED: schools-command.html previously had zero outbound nav links to its own schools-strategist.html/schools-executive-portal.html (both of those pages already fully cross-linked back to Command and to each other -- only Command's outbound side was missing). Added real #tsm-chain-strat / #tsm-chain-exec links to the TSM cross-links bar; this spec exercises those new links instead of a goto workaround. Run once in Codespaces and correct any selector drift before treating as final.",
+  "steps": [
+    { "shot": "001-command-load", "goto": "/html/war-rooms/schools-command/schools-command.html", "waitMs": 1500 },
+
+    { "shot": "002-open-ai-tab", "click": "[data-tab=\"ai\"]", "waitFor": "#tab-ai", "waitMs": 800 },
+
+    { "shot": "003-load-prompt-from-library", "click": ".pr-item", "waitFor": "#ai-input", "waitMs": 500 },
+
+    { "shot": "004-run-ai-analysis", "click": "#schBtnRunAnalysis", "waitFor": "#ai-output", "waitMs": 4000 },
+
+    { "shot": "005-relayed-to-strategist", "click": "#tsm-chain-strat", "waitMs": 1500 },
+
+    { "shot": "006-strategist-load", "waitFor": "#wrap .kpi-row", "waitMs": 1000 },
+
+    { "shot": "007-strategist-ai-summary", "waitFor": ".ai-box", "waitMs": 600 },
+
+    { "shot": "008-executive-view", "click": "a.hbtn.primary[href=\"schools-executive-portal.html\"]", "waitMs": 1500 },
+
+    { "shot": "009-exec-portal-kpis", "waitFor": "#wrap", "waitMs": 800 }
+  ]
+}
